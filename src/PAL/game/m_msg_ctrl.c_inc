static void mMsg_Set_item_str_init(mMsg_Window_c* msg_p, int str_no, int article_indef, int article_def, int gender) {
    mMsg_String_c* string = &msg_p->item_str[str_no];

    mem_clear(string->str, mMsg_FREE_STRING_LEN, CHAR_SPACE);
    string->article_indef = article_indef;
    string->article_def = article_def;
    string->gender = gender;
}

static void mMsg_Set_item_str_sub(mMsg_Window_c* msg_p, int str_no, u8* str, u32 str_len) {
    if (str_no >= mMsg_ITEM_STR0 && str_no < mMsg_ITEM_STR_NUM && str != NULL) {
        mMsg_String_c* string = &msg_p->item_str[str_no];
        u32 i = 0;
        u8 buffer[mMsg_STRING_TAG_BUFFER_SIZE];

        mem_clear(buffer, sizeof(buffer), CHAR_SPACE);
        if (str_len > sizeof(buffer)) {
            str_len = sizeof(buffer);
        }
        bcopy(str, buffer, str_len);

        while (i < sizeof(buffer)) {
            u8* data_p = buffer + i;
            char code = *data_p;
            int code_size = mFont_CodeSize_get(data_p);
            int found = FALSE;

            if ((u8)code == CHAR_MESSAGE_TAG) {
                // These two tag queries are retained by the original PAL code.
                mFont_Get_TagGroup(data_p);
                mFont_Get_TagId(data_p);
                if (mFont_Check_TagId(data_p, 3 * sizeof(u8), mFont_TAG_GROUP_GRM, mFont_TAG_GRM_STRING_INFO)) {
                    string->gender = data_p[mFont_TAG_HEADER_SIZE];
                    string->article_indef = (s8)data_p[mFont_TAG_HEADER_SIZE + 1] + 1;
                    string->article_def = (s8)data_p[mFont_TAG_HEADER_SIZE + 2] + 1;
                    mMsg_MoveDataCut(buffer, i, i + code_size, sizeof(buffer), TRUE);
                    found = TRUE;
                }
            }

            if (!found) {
                i += code_size;
            }
        }

        bcopy(buffer, string->str, mMsg_FREE_STRING_LEN);
    }
}

