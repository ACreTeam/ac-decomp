}

// This seems to be a flag stored elsewhere due to its position in sbss,
// but it's not used in any linked fucnctions, so I'm placing it here.
static int NA_PAUSE_FLAG = FALSE;

static void Na_PauseStart(void) {
    NA_PAUSE_FLAG = TRUE;
}

static void Na_PauseEnd(void) {
    NA_PAUSE_FLAG = FALSE;
}
