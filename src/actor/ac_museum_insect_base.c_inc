#include "ac_museum_insect_priv.h"

void mID_insect_moveF(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    actor->velocity.x = actor->speed * sin_s(actor->rotation.y);
    actor->velocity.z = actor->speed * cos_s(actor->rotation.y);
    xyz_t_add(&actor->position, &actor->velocity, &actor->position);
}

#include "../src/actor/ac_museum_insect_chou.c_inc"
#include "../src/actor/ac_museum_insect_semi.c_inc"
#include "../src/actor/ac_museum_insect_tonbo.c_inc"
#include "../src/actor/ac_museum_insect_batta.c_inc"
#include "../src/actor/ac_museum_insect_tentou.c_inc"
#include "../src/actor/ac_museum_insect_hachi.c_inc"
#include "../src/actor/ac_museum_insect_kabuto.c_inc"
#include "../src/actor/ac_museum_insect_kuwagata.c_inc"

void minsect_amenbo_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->position = amenbo_center_pos;
    actor->velocity = ZeroVec;
    actor->_44 = ZeroVec;
    actor->rotation = ZeroSVec;
    actor->rotation.y = qrand();
    actor->work_s[0] = actor->rotation.y;
    actor->process_timer = (s16)RANDOM_F(60.f);
    actor->speed = 0.f;
}

void minsect_amenbo_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->is_active = get_now_mind_flag(actor, game);
    actor->process_timer--;
    if (actor->speed > 0.f) {
        if (!add_calc(&actor->speed, 0.f, CALC_EASE(0.1), 0.05f, 0.005f)) {
            actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(120.f));
            actor->process_timer = RANDOM_F(60.f);
            if (actor->is_active == 0) {
                actor->process_timer *= 10;
            }
        }
        mID_insect_moveF(actor);
    } else {
        if (actor->process_timer < 0) {
            if (!add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE(0.5f), DEG2SHORT_ANGLE(5),
                                       DEG2SHORT_ANGLE(0.5f))) {
                actor->speed = (RANDOM_F(1.19f) + 1.15f) * 0.5f;
                Common_Get(clip.effect_clip)->effect_make_proc(69, actor->position, 1, actor->rotation.y, game, 0, 1, 0);
            }
        }
    }

    if (actor->position.x < amenbo_center_pos.x - 25.f) {
        actor->position.x = amenbo_center_pos.x - 25.f;
        actor->process_timer = 0;
        actor->speed = 0.f;
        actor->work_s[0] = -actor->rotation.y;
    } else if (actor->position.x > amenbo_center_pos.x + 25.f) {
        actor->position.x = amenbo_center_pos.x + 25.f;
        actor->process_timer = 0;
        actor->speed = 0.f;
        actor->work_s[0] = -actor->rotation.y;
    }

    if (actor->position.z < amenbo_center_pos.z - 18.f) {
        actor->position.z = amenbo_center_pos.z - 18.f;
        actor->process_timer = 0;
        actor->speed = 0.f;
        actor->work_s[0] = (s16)DEG2SHORT_ANGLE2(180);
        actor->work_s[0] -= actor->rotation.y;
    } else if (actor->position.z > amenbo_center_pos.z + 18.f) {
        actor->position.z = amenbo_center_pos.z + 18.f;
        actor->process_timer = 0;
        actor->speed = 0.f;
        actor->work_s[0] = (s16)DEG2SHORT_ANGLE2(180);
        actor->work_s[0] -= actor->rotation.y;
    }
}

void minsect_amenbo_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim_xlu(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y + (s16)DEG2SHORT_ANGLE2(180), actor->rotation.z, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);
}

#include "../src/actor/ac_museum_insect_mino.c_inc"
#include "../src/actor/ac_museum_insect_kumo.c_inc"
#include "../src/actor/ac_museum_insect_goki.c_inc"
#include "../src/actor/ac_museum_insect_genji.c_inc"
#include "../src/actor/ac_museum_insect_dango.c_inc"

void ari_alone_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->flags |= 1;
    if (RANDOM_F(1.f) < (2.f / 3.f)) {
        actor->work_s[2] = 1;
        actor->position = ari_rail_pos[0];
    } else {
        actor->position = ari_rail_pos[2];
        actor->work_s[2] = -1;
    }
    actor->work_s[0] = 1;
    actor->speed = RANDOM_F(0.25f) + 0.05f;
    actor->process_timer = (s16)RANDOM_F(1160.f) + 40;
    actor->params.work_f[1] = RANDOM2_F(5.f);
}

void ari_alone_make(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    int i = 0;
    for (i = 0; i < 15; actor++, i++) {
        if ((actor->flags & 1) == 0) {
            ari_alone_ct(actor, game);
            break;
        }
    }
}

void ari_alone_dt(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->flags &= ~1;
}

void ari_alone_move(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p = ari_rail_pos[actor->work_s[0]];
    xyz_t p2;
    actor->process_timer--;
    if (actor->speed > 0.f) {
        f32 v;
        s16 s;
        if (actor->work_s[2] > 0) {
            v = 307.f - actor->position.x;
        } else {
            v = actor->position.x - 177.f;
        }
        s = DEG2SHORT_ANGLE2((v * 360.f) / 130.f);
        if (actor->work_s[0] == 1) {
            actor->params.work_f[0] = (-5.f - (GETREG(TAKREG, 0x32) * 0.1f)) * sin_s(s);
        } else {
            actor->params.work_f[0] = (5.f + (GETREG(TAKREG, 0x32) * 0.1f)) * sin_s(s);
        }
        p.z += actor->params.work_f[1];
        if (!chase_xyz_t(&actor->position, &p, actor->speed)) {
            if (actor->work_s[0] == 1) {
                actor->work_s[0] += actor->work_s[2];
            } else {
                ari_alone_dt(actor, game);
            }
        }
        xyz_t_sub(&p, &actor->position, &p2);
        actor->work_s[1] = atans_table(p2.z, p2.x);
        add_calc_short_angle2(&actor->rotation.y, actor->work_s[1], CALC_EASE2(0.3f), DEG2SHORT_ANGLE(1.25f),
                              DEG2SHORT_ANGLE(0.25f));
        if (actor->process_timer < 0) {
            actor->speed = 0.f;
            actor->process_timer = (s16)RANDOM_F(260.f) + 40;
        }
    } else if (actor->process_timer < 0) {
        actor->speed = RANDOM_F(0.25f) + 0.05f;
        actor->process_timer = (s16)RANDOM_F(1160.f) + 40;
    }
}

#include "../src/actor/ac_museum_insect_okera.c_inc"
#include "../src/actor/ac_museum_insect_ka.c_inc"

extern Gfx act_m_mu_ariT_model;
void ari_alone_draw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim_xlu(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z + actor->params.work_f[0], MTX_LOAD);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(NEXT_POLY_OPA_DISP, &act_m_mu_ariT_model);
    CLOSE_DISP(game->graph);
}

void minsect_ari_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    MUSEUM_INSECT_PRIVATE_DATA* priv = &MI_Control_Actor->ants[0];
    int i;
    actor->process_timer = (s16)RANDOM_F(100.f) + 20;
    for (i = 0; i < 15; priv++, i++) {
        ari_alone_dt(priv, game);
    }
}

void minsect_ari_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    MUSEUM_INSECT_PRIVATE_DATA* priv = MI_Control_Actor->ants;
    int i;
    if (actor->process_timer-- < 0) {
        actor->process_timer = (s16)RANDOM_F(100.f) + 20;
        ari_alone_make(priv, game);
    }
    for (i = 0; i < 15; priv++, i++) {
        if (priv->flags & 1) {
            ari_alone_move(priv, game);
            priv->scale = actor->scale;
        }
    }
}

void minsect_ari_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    MUSEUM_INSECT_PRIVATE_DATA* priv = MI_Control_Actor->ants;
    int i;
    for (i = 0; i < 15; priv++, i++) {
        if (priv->flags & 1) {
            ari_alone_draw(priv, game);
        }
    }
}

extern Gfx ef_shadow_insect_modelT;
void minsect_draw_shadow(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    GAME_PLAY* play = (GAME_PLAY*)game;
    u8 shadow = play->kankyo.shadow_alpha;
    f32 v;
    f32 scale;
    u8 alpha;

    f32 v0;
    f32 v1;

    if (actor->position.z > -40.f && actor->position.z < 40.f) {
        v = 46.f;
    } else if (actor->position.x > 120.f && actor->position.x < 440.f &&
               (actor->position.z > 120.f && actor->position.z < 280.f || actor->position.z > 360.f && actor->position.z < 520.f)) {
        v = 45.f;
    } else {
        v = 40.f;
    }

    v0 = 100.f - (actor->position.y - v);
    v1 = 1.f + (GETREG(TAKREG, 0x2b) * 0.1f);
    alpha = (int)(v0 * v1 + 40.0f + GETREG(TAKREG, 0x2c));
    alpha = (alpha * shadow) >> 8;

    scale = (GETREG(TAKREG, 0x28) * 0.001f + 0.005f);
    scale *= minsect_shadow_scale_tbl[(int)actor->insect_type];

    Matrix_translate(actor->position.x, v, actor->position.z, MTX_LOAD);
    Matrix_scale(scale, scale, scale, MTX_MULT);
    _texture_z_light_fog_prim_shadow(game->graph);

    OPEN_SHADOW_DISP(game->graph);
    gDPSetPrimColor(SHADOW_DISP++, 0, 255, 0, 0, 0, alpha);
    gSPMatrix(SHADOW_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(SHADOW_DISP++, &ef_shadow_insect_modelT);
    CLOSE_SHADOW_DISP(game->graph);
}

void minsect_fly_BGCheck(MUSEUM_INSECT_PRIVATE_DATA* actor, f32 f1, f32 f2) {
    const f32 min = 50.0f;
    const f32 max = 510.0f;

    actor->flags &= ~0x1e;
    if (actor->position.x < min) {
        actor->position.x = min;
        actor->flags |= 2;
    } else if (actor->position.x > max) {
        actor->position.x = max;
        actor->flags |= 4;
    }

    if (actor->position.z < f2) {
        actor->flags |= 8;
    } else if (actor->position.z > f1) {
        actor->flags |= 0x10;
    }
}

void minsect_garden_BGCheck(MUSEUM_INSECT_PRIVATE_DATA* actor, f32 f1, f32 f2) {
    const f32 v1 = 130.f, v2 = 430.f;
    actor->flags &= ~0x1e;
    actor->flags &= ~0x20;
    if (actor->position.x < v1) {
        actor->position.x = v1;
        actor->flags |= 2;
    } else if (actor->position.x > v2) {
        actor->position.x = v2;
        actor->flags |= 4;
    }

    if (actor->position.z < f2) {
        actor->position.z = f2;
        actor->flags |= 8;
    } else if (actor->position.z > f1) {
        actor->position.z = f1;
        actor->flags |= 0x10;
    }

    if (actor->position.y < 45.f) {
        actor->position.y = 45.f;
        actor->flags |= 0x20;
    }
}

void minsect_flower_BGCheck(MUSEUM_INSECT_PRIVATE_DATA* actor, xyz_t* p) {
    xyz_t p2;
    f32 dsq;

    xyz_t_sub(&actor->position, p, &p2);
    dsq = SQ(p2.x) + SQ(p2.z);
    actor->flags &= ~2;
    if (dsq > SQ(15)) {
        f32 d = sqrtf(dsq);

        p2.x *= (14.9f) / d;
        p2.z *= (14.9f) / d;
        actor->position.x = p->x + p2.x;
        actor->position.z = p->z + p2.z;
        actor->flags |= 2;
    }
    actor->position.y = (-p2.z * 5.f) / 20.f + 65.f;
}

void minsect_goki_BGCheck(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    f32 v1;
    f32 v2;
    f32 a1;
    f32 a2;
    f32 m1;
    f32 m2;
    f32 am1;
    f32 am2;

    v1 = actor->position.x - 115.f;
    v2 = 445.f - actor->position.x;
    actor->flags &= ~0x1e;
    actor->flags &= ~0x20;
    if (actor->position.x < 45.f) {
        actor->position.x = 45.f;
        actor->flags |= 2;
    } else if (actor->position.x > 515.f) {
        actor->position.x = 515.f;
        actor->flags |= 4;
    }

    if (actor->position.z < 45.f) {
        actor->position.z = 45.f;
        actor->flags |= 8;
    } else if (actor->position.z > 595.f) {
        actor->position.z = 595.f;
        actor->flags |= 0x10;
    }

    if (actor->position.y < 40.f) {
        actor->position.y = 40.f;
        actor->flags |= 0x20;
    }

    if (v1 > 0.f && v2 > 0.f) {
        int i;
        for (i = 0; i < 2; i++) {
            static const float BG_ZB_tbl[2] = { 115.f, 355.f };
            static const float BG_ZF_tbl[2] = { 285.f, 525.f };
            a1 = actor->position.z - BG_ZB_tbl[i];
            a2 = BG_ZF_tbl[i] - actor->position.z;
            if (a1 > 0.f && a2 > 0.f) {
                // float regswaps here
                if (v1 > v2) {
                    m1 = v2;
                } else {
                    m1 = -v1;
                }
                if (a1 > a2) {
                    m2 = a2;
                } else {
                    m2 = -a1;
                }
                am1 = ABS(m1);
                am2 = ABS(m2);
                if (am2 > am1) {
                    actor->position.x += m1;
                    if (m1 > 0.f) {
                        actor->flags |= 4;
                    } else {
                        actor->flags |= 2;
                    }
                } else {
                    actor->position.z += m2;
                    if (m2 > 0.f) {
                        actor->flags |= 0x10;
                    } else {
                        actor->flags |= 8;
                    }
                }
            }
        }
    }
}

void minsect_kanban_BGCheck(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    static float KANBAN_XL_TBL[] = { 162.f, 325.f };
    static float KANBAN_XR_TBL[] = { 195.f, 358.f };
    int i;
    for (i = 0; i < 2; i++) {
        if (actor->position.x > KANBAN_XL_TBL[i] && actor->position.x < KANBAN_XR_TBL[i]) {
            f32 v = actor->position.z - actor->velocity.z;
            const f32 vv = 508.f;
            const f32 tt = 500.f;
            if (v - vv >= 0.f && actor->position.z - vv < 0.f) {
                actor->position.z = vv;
            } else if (v - tt <= 0.f && actor->position.z - tt > 0.f) {
                actor->position.z = tt;
            }
        }
    }
}

void minsect_tree_ObjCheck(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    int i = 0;
    const f32 d = SQ(20.f);
    actor->flags &= ~0x80;
    for (i = 0; i < 8; i++) {
        f32 x = tree_pos[i].x - actor->position.x;
        f32 z = tree_pos[i].z - actor->position.z;
        f32 dsq = SQ(x) + SQ(z);
        if (dsq < d) {
            s16 ang = atans_table(z, x);
            f32 dist = 20.1f - sqrtf(dsq);
            actor->position.x -= dist * sin_s(ang);
            actor->position.z -= dist * cos_s(ang);
            actor->flags |= 0x80;
        }
    }
}

void minsect_rock_ObjCheck(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    int i = 0;
    const f32 d = SQ(22.f);
    actor->flags &= ~0x40;
    for (i = 0; i < 2; i++) {
        f32 x = rock_pos[i].x - actor->position.x;
        f32 z = rock_pos[i].z - actor->position.z;
        f32 dsq = SQ(x) + SQ(z);
        if (dsq < d) {
            s16 ang = atans_table(z, x);
            f32 dist = 22.f - sqrtf(dsq);
            actor->position.x -= dist * sin_s(ang);
            actor->position.z -= dist * cos_s(ang);
            actor->flags |= 0x40;
        }
    }
}

void minsect_batta_ObjCheck(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    int c = 6;
    int i;
    if (MI_Control_Actor->privInsects[0x21].flags & 1 &&
        MI_Control_Actor->privInsects[0x21].process == okera_normal_process) {
        c = 7;
    }
    for (i = 0; i < c; i++) {
        static int idx_tbl[7] = { 0xd, 0xe, 0xf, 0x10, 0x11, 0x12, 0x21 };
        MUSEUM_INSECT_PRIVATE_DATA* priv = &MI_Control_Actor->privInsects[idx_tbl[i]];
        if (priv != actor && priv->flags & 1) {
            f32 x = priv->position.x - actor->position.x;
            f32 z = priv->position.z - actor->position.z;
            f32 dsq = SQ(x) + SQ(z);
            const f32 d = SQ(GETREG(NMREG, 0x5a) + 10.f);
            if (dsq < d) {
                s16 ang = atans_table(z, x);
                f32 dist = (GETREG(NMREG, 0x5a) + 10.f) - sqrtf(dsq);
                actor->position.x -= dist * sin_s(ang);
                actor->position.z -= dist * cos_s(ang);
            }
        }
    }
}

BOOL get_now_mind_flag(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    int now_sec = Common_Get(time.now_sec);
    BOOL b;

    if (actor->active_start_sec == 0 && actor->rest_start_sec == 0) {
        return TRUE;
    }

    if (actor->rest_start_sec > actor->active_start_sec) {
        if (now_sec < actor->active_start_sec) {
            b = FALSE;
        } else if (now_sec < actor->rest_start_sec) {
            b = TRUE;
        } else {
            b = FALSE;
        }
    } else {
        if (now_sec < actor->rest_start_sec) {
            b = TRUE;
        } else if (now_sec < actor->active_start_sec) {
            b = FALSE;
        } else {
            b = TRUE;
        }
    }
    return b;
}

void set_relax_active_time(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->insect_type == 6) {
        int now_sec = Common_Get(time.now_sec);
        if (now_sec < (14280)) {
            actor->active_start_sec = 14400;
            actor->rest_start_sec = 28800;
        } else if (now_sec < (28680)) {
            actor->active_start_sec = 57600;
            actor->rest_start_sec = 28800;
        } else if (now_sec < (57480)) {
            actor->active_start_sec = 57600;
            actor->rest_start_sec = 68400;
        } else if (now_sec < (68280)) {
            actor->active_start_sec = 14400;
            actor->rest_start_sec = 68400;
        } else {
            actor->active_start_sec = 14400;
            actor->rest_start_sec = 28800;
        }
    } else {
        actor->rest_start_sec = relax_time_tbl[actor->insect_type];
        actor->active_start_sec = active_time_tbl[actor->insect_type];
    }
    if (actor->rest_start_sec && actor->active_start_sec) {
        actor->rest_start_sec += (int)RANDOM2_F(240.f);
        actor->active_start_sec += (int)RANDOM2_F(240.f);
    }
    actor->is_active = get_now_mind_flag(actor, game);
}
