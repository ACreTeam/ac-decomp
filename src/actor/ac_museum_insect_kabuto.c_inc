#include "ac_museum_insect_priv.h"

void minsect_kabuto_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    switch (actor->insect_type) {
        case 8:
            actor->work_s[0] = 0;
            break;
        case 0x13:
        case 0x14:
        case 0x15:
        case 0x16:
        case 0x17:
            actor->work_s[0] = actor->insect_type - 0x12;
            break;
        case 0x1e:
        case 0x1f:
        default:
            actor->work_s[0] = actor->insect_type - 0x17;
            break;
    }
    actor->position = kabuto_base_pos[actor->work_s[0]];
    actor->_44 = actor->position;
    actor->velocity = ZeroVec;
    actor->speed = 0.05f;
    actor->rotation = ZeroSVec;
    actor->work_s[1] = qrand();
    actor->process_timer = (s16)RANDOM_F(120) + 60;
    actor->work_s[4] = (s16)RANDOM_F(60) + 60;
    actor->work_s[5] = 0;
}

void minsect_kabuto_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->is_active = get_now_mind_flag(actor, game);
    actor->process_timer--;
    if (actor->flags & 2) {
        actor->position.y += actor->speed * (cos_s(actor->work_s[1]) * 0.5f + 0.5f);
        actor->work_s[1] += ((s16)DEG2SHORT_ANGLE(GETREG(TAKREG, 0x14) + 30.0f) >> 1);
        actor->rotation.z = DEG2SHORT_ANGLE2(GETREG(TAKREG, 0x15) * 0.1f + 2.0f) * sin_s(actor->work_s[1]);
        if (sin_s(actor->work_s[1]) <= 0.1 && sin_s(actor->work_s[1]) >= -0.1) {
            if (actor->work_s[3]) {
                actor->work_s[3] = 0;
            } else {
                actor->work_s[3] = DEG2SHORT_ANGLE(-7);
            }
        }
        if (actor->process_timer < 0) {
            actor->speed = 0.0f;
            actor->flags &= ~2;
            actor->work_s[3] = DEG2SHORT_ANGLE(-7);
            actor->process_timer = (s16)RANDOM_F(300.f) + 60;
            if (actor->is_active == 0) {
                actor->process_timer *= 10;
            }
        }

        if (actor->position.y > actor->_44.y + 2.0f) {
            actor->position.y = actor->_44.y + 2.0f;
            actor->flags &= ~2;
            actor->flags |= 8;
            actor->work_s[3] = DEG2SHORT_ANGLE(-7);
            actor->process_timer = (s16)RANDOM_F(300.f) + 60;
            if (actor->is_active == 0) {
                actor->process_timer *= 10;
            }
        } else if (actor->position.y < actor->_44.y - 2.0f) {
            actor->position.y = actor->_44.y - 2.0f;
            actor->flags &= ~2;
            actor->flags |= 4;
            actor->work_s[3] = DEG2SHORT_ANGLE(-7);
            actor->process_timer = (s16)RANDOM_F(300.f) + 60;
            if (actor->is_active == 0) {
                actor->process_timer *= 10;
            }
        }
    } else {
        if (actor->process_timer < 0) {
            if (actor->flags & 4) {
                actor->speed = 0.05f;
            } else if (actor->flags & 8 || RANDOM_F(1.0f) > 0.5f) {
                actor->speed = -0.05f;
            } else {
                actor->speed = 0.05f;
            }
            actor->flags &= ~0xc;
            actor->work_s[3] = DEG2SHORT_ANGLE(-7);
            actor->process_timer = (s16)RANDOM_F(120.f) + 60;
            actor->flags |= 2;
        }
        actor->work_s[4]--;
        if (actor->work_s[4] < 0) {
            actor->work_s[5]++;
            actor->work_s[3] = DEG2SHORT_ANGLE(-7);
            actor->work_s[4] = (s16)RANDOM_F(60.f) + 60;
            actor->work_s[6] = DEG2SHORT_ANGLE(RANDOM2_F(30.f));
            if (actor->work_s[5] > (s16)(1.0f + RANDOM_F(3.0f))) {
                actor->work_s[5] = 0;
                actor->work_s[4] = (s16)((s16)RANDOM_F(60.0f) + 60) * 5;
                if (actor->is_active == 0) {
                    actor->work_s[4] *= 2;
                }
                actor->work_s[6] = 0;
            }
        }
        if (actor->work_s[2] == actor->work_s[3]) {
            actor->work_s[3] = 0;
        }
        add_calc_short_angle2(&actor->rotation.z, actor->work_s[6], CALC_EASE2(0.4f),
                              (s16)(DEG2SHORT_ANGLE(GETREG(NMREG, 3) * 0.01f + 5.0f) >> 1) >> 1,
                              DEG2SHORT_ANGLE(0.25f));
    }
    add_calc_short_angle2(&actor->work_s[2], actor->work_s[3], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f), DEG2SHORT_ANGLE(0.25f));
}

void minsect_kabuto_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);

    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(0, 0, actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(actor->work_s[2], 0, 0, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    Matrix_rotateXYZ(DEG2SHORT_ANGLE(90), 0, DEG2SHORT_ANGLE2(180), MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);

    if (actor->insect_type == 8) {
        OPEN_POLY_XLU_DISP(game->graph);
        gDPSetEnvColor(POLY_XLU_DISP++, 0xff, 0xff, 0xff, 0xff);
        gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
        gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][1]);
        CLOSE_POLY_XLU_DISP(game->graph);
    }
}

xyz_t kabuto_base_pos[9] = { { 165.5f, 78.5f, 482.5f }, { 389.5f, 66.5f, -14.5f }, { 241.5f, 67.0f, -15.5f },
                             { 165.0f, 81.5f, 0.5f },   { 89.0f, 64.0f, -15.5f },  { 466.0f, 84.0f, 1.5f },
                             { 171.0f, 64.5f, 5.5f },   { 319.0f, 81.0f, 1.0f },   { 313.0f, 63.0f, 5.5f } };
