#include "ac_museum_insect_priv.h"

void mi_batta_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 v = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (v < 60.f) {
        if (player->actor_class.speed > 1.4f) {
            actor->work_s[7] += (s16)((v / 60.f) * 8.f);
        } else if (player->actor_class.speed > 5.0f) {
            actor->work_s[7] += (s16)((v / 60.f) * 20.f);
        }
    }
}

void mi_batta_suzumushi_hane_anime(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    static f32 scaleX_table[7] = { 1.15f, 0.9f, 1.15f, 0.9f, 1.15f, 0.9f, 1.15f };
    if (actor->work_s[9] < 7) {
        if (chase_f(&actor->params.work_f[0], (GETREG(NMREG, 1) * 0.01f + 1.0f) * scaleX_table[actor->work_s[9]], 0.23f) == 1) {
            actor->work_s[9]--;
            if (actor->work_s[9] < 0) {
                actor->work_s[9] = 0;
            }
        }
    } else {
        actor->work_s[9]--;
    }
}

void mi_batta_hane_anime(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    static f32 scaleX_table[7] = { 1.15f, 0.5f, 1.15f, 0.5f, 1.15f, 0.5f, 1.15f };
    if (actor->work_s[6] < 7) {
        if (chase_f(&actor->params.work_f[0], (GETREG(NMREG, 1) * 0.01f + 1.0f) * scaleX_table[actor->work_s[6]], 0.23f) == 1) {
            actor->work_s[6]--;
            if (actor->work_s[6] < 0) {
                actor->work_s[6] = 0;
            }
        }
    } else {
        actor->work_s[6]--;
    }
}

void minsect_batta_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    static const xyz_t batta_init_pos = { 280.f, 45.f, 440.f };
    actor->position = batta_init_pos;
    actor->position.x += RANDOM2_F(300.f);
    actor->position.z += RANDOM2_F(140.f);
    actor->rotation = ZeroSVec;
    actor->velocity = ZeroVec;
    actor->_44 = ZeroVec;
    actor->_44.y = -0.05f;
    actor->rotation.y = qrand();
    actor->work_s[0] = qrand();
    actor->work_s[1] = 0;
    actor->work_s[2] = 0;
    actor->work_s[5] = 0;
    actor->params.work_f[0] = 1.0f;
    actor->work_s[6] = 0;
    actor->work_s[9] = 0;
    minsect_batta_normal_process_init(actor, game);
}

void minsect_batta_normal_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    s16 s = qrand();
    xyz_t p = actor->position;
    p.x += 30.f * sin_s(s);
    p.z += 30.f * cos_s(s);
    actor->process = minsect_batta_normal_process;
    if (p.x < 130.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(90);
    } else if (p.x > 430.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(-90);
        actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
    } else if (p.z > 510.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(-180);
        actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
    } else if (p.z < 370.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(RANDOM2_F(90));
    } else {
        actor->work_s[0] = s;
    }
    actor->work_s[4] = DEG2SHORT_ANGLE(-7);
    actor->work_s[5] = 0;
}

void minsect_batta_normal_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->work_s[3] == DEG2SHORT_ANGLE(-7) && actor->work_s[4]) {
        actor->work_s[4] = 0;
    }
    if (!add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE2(0.5), DEG2SHORT_ANGLE(15),
                               DEG2SHORT_ANGLE(0.25f))) {
        if (actor->work_s[2] == 0 && RANDOM_F(1.0f) > 0.3f) {
            actor->work_s[2] = 1;
            if (RANDOM_F(1.0f) >= 0.5f) {
                actor->work_s[0] += (s16)(DEG2SHORT_ANGLE(RANDOM_F(30)) + DEG2SHORT_ANGLE(20));
            } else {
                actor->work_s[0] -= (s16)(DEG2SHORT_ANGLE(RANDOM_F(30)) + DEG2SHORT_ANGLE(20));
            }
            actor->work_s[4] = DEG2SHORT_ANGLE(-7);
        } else {
            if (RANDOM_F(1.0f) > 0.8f || GETREG(NMREG, 2)) {
                minsect_batta_silent_process_init(actor, game);
            } else {
                minsect_batta_jump_wait_process_init(actor, game);
            }
        }
    }
}

void minsect_batta_silent_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = (s16)((s16)RANDOM_F(360) + 120) * 5;
    if (actor->is_active == 0) {
        actor->process_timer = (s16)((s16)RANDOM_F(360.f) + 120) * 2;
    }
    actor->process = minsect_batta_silent_process;
    return;
}

void minsect_batta_silent_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->process_timer-- < 0) {
        if (RANDOM_F(1.0f) > 0.6f) {
            minsect_batta_jump_process_init(actor, game);
        } else {
            minsect_batta_normal_process_init(actor, game);
        }
    }
}

void minsect_batta_jump_wait_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->work_s[2] = 0;
    actor->process_timer = (s16)RANDOM_F(360.f) + 120;
    if (actor->is_active == 0) {
        actor->process_timer *= 5;
    }
    actor->process = minsect_batta_jump_wait_process;
    actor->work_s[4] = 0;
}

void minsect_batta_jump_wait_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->process_timer-- < 0) {
        minsect_batta_jump_process_init(actor, game);
    }
}

void minsect_batta_jump_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->speed = RANDOM_F(1.0f) + 1.0f;
    actor->velocity.y = 0.75f;
    actor->process = minsect_batta_jump_process;
    if (RANDOM_F(1.0f) > 0.6f || GETREG(NMREG, 2)) {
        actor->work_s[5] = 1;
        actor->work_s[6] = 7;
    }
}

void minsect_batta_jump_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->rotation.x = -atans_table(actor->speed, actor->velocity.y);
    if (actor->velocity.y < 0.0f && actor->flags & 0x20) {
        actor->speed = 0.f;
        actor->rotation.x = 0;
        minsect_batta_normal_process_init(actor, game);
    }
    mi_batta_hane_anime(actor);
    if (actor->work_s[6] <= 0) {
        actor->work_s[6] = 7;
    }
}

void minsect_batta_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    static u8 batta_sound_data[4] = { 0x9f, 0x9e, 0xa0, 0x9d };
    actor->is_active = get_now_mind_flag(actor, game);
    mi_batta_check_player(actor, game);
    actor->work_s[7]--;
    if (actor->work_s[7] < 0) {
        actor->work_s[7] = 0;
    }
    if (actor->work_s[7] > 1600) {
        actor->work_s[7] = 1600;
    }

    if (actor->is_active) {
        if (actor->work_s[7] > 150 && actor->process != minsect_batta_jump_process) {
            minsect_batta_jump_process_init(actor, game);
            actor->work_s[7] = 0;
        }
    } else {
        if (actor->work_s[7] > 1000 && actor->process != minsect_batta_jump_process) {
            minsect_batta_jump_process_init(actor, game);
            actor->work_s[7] = 0;
        }
    }

    if (actor->insect_type >= 15 && actor->process != minsect_batta_jump_process) {
        int id = actor->insect_type - 15;
        PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
        xyz_t p = player->actor_class.world.position;
        f32 dist = search_position_distanceXZ(&actor->position, &p);
        if (actor->process != minsect_batta_silent_process && actor->is_active) {
            if (actor->insect_type == 17) {
                mi_batta_suzumushi_hane_anime(actor);
                if (actor->work_s[9] <= 0) {
                    actor->work_s[9] = 7;
                }
            }
            if (dist < 200.f) {
                sAdo_OngenPos((u32)actor, batta_sound_data[id], &actor->position);
            }
        } else if (actor->process == minsect_batta_silent_process && actor->is_active == 0) {
            if (actor->insect_type == 17) {
                mi_batta_suzumushi_hane_anime(actor);
                if (actor->work_s[9] <= 0) {
                    actor->work_s[9] = 7;
                }
            }
            if (dist < 200.f) {
                sAdo_OngenPos((u32)actor, batta_sound_data[id], &actor->position);
            }
        }
    }

    actor->process(actor, game);
    mID_insect_moveF(actor);
    actor->velocity.y += actor->_44.y;
    minsect_batta_ObjCheck(actor);
    minsect_tree_ObjCheck(actor);
    minsect_rock_ObjCheck(actor);
    minsect_kanban_BGCheck(actor);
    minsect_garden_BGCheck(actor, 510.0, 370.0);
    add_calc_short_angle2(&actor->work_s[3], actor->work_s[4], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f), DEG2SHORT_ANGLE(0.25f));
}

void minsect_batta_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);

    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(actor->work_s[3], 0, 0, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);

    if (actor->work_s[5] || actor->insect_type == 17) {
        _texture_z_light_fog_prim_xlu(game->graph);
        OPEN_POLY_XLU_DISP(game->graph);
        gDPSetEnvColor(POLY_XLU_DISP++, 0xff, 0xff, 0xff, 0xff);
        Matrix_scale(actor->params.work_f[0], 1.0f, 1.0f, MTX_MULT);
        gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
        gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][1]);
        CLOSE_POLY_XLU_DISP(game->graph);
    }

    minsect_draw_shadow(actor, game);
}
