#include "ac_museum_insect_priv.h"

const xyz_t okera_base_pos = { 235.f, 45.f, 445.f };

void mi_okera_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (dist < 60.f) {
        if (player->actor_class.speed > 1.4f) {
            actor->work_s[6] += (s16)((dist / 60.f) * 8.f);
        } else if (player->actor_class.speed > 5.f) {
            actor->work_s[6] += (s16)((dist / 60.f) * 20.f);
        }
    }
}

void minsect_okera_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    okera_dig_wait_process_init(actor, game);
}

void okera_dig_up_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    s16 s = qrand();
    f32 v = RANDOM_F(25.f);
    actor->position = okera_base_pos;
    actor->position.x += sin_s(s) * v;
    actor->position.y -= 2.f;
    actor->position.z += sin_s(s) * v;
    actor->velocity = ZeroVec;
    actor->_44 = ZeroVec;
    actor->velocity.y = 0.75f;
    actor->_44.y = -0.05f;
    actor->speed = 0.625;
    actor->rotation = ZeroSVec;
    if (actor->position.z >= okera_base_pos.z) {
        actor->rotation.y = qrand();
    } else {
        actor->rotation.y = DEG2SHORT_ANGLE(RANDOM2_F(180));
    }
    actor->work_s[0] = actor->rotation.y;
    actor->work_s[3] = 0;
    actor->process = okera_dig_up_process;
}

void okera_dig_up_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->flags & 0x20 && actor->velocity.y < 0.f) {
        actor->rotation.x = 0;
        okera_normal_process_init(actor, game);
    } else {
        mID_insect_moveF(actor);
        actor->velocity.y += actor->_44.y;
        actor->rotation.x = -atans_table(actor->speed, actor->velocity.y);
    }
}

void okera_normal_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->speed = 0.65f;
    actor->process_timer = (s16)RANDOM_F(68.f) + 24;
    actor->work_s[2] = (s16)(RANDOM_F(1500.f) + 300.f);
    actor->process = okera_normal_process;
}

void okera_normal_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    mi_okera_check_player(actor, game);
    actor->work_s[6]--;
    if (actor->work_s[6] < 0) {
        actor->work_s[6] = 0;
    }
    if (actor->work_s[6] > 900) {
        actor->work_s[6] = 900;
    }
    if (actor->work_s[6] > 150 && actor->speed == 0.f) {
        PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
        s16 s = player->actor_class.shape_info.rotation.y;
        actor->work_s[6] = 0;
        actor->process_timer = (s16)RANDOM_F(68.f) + 24;
        actor->speed = 1.615f;
        actor->work_s[0] = s + DEG2SHORT_ANGLE(RANDOM2_F(30.f));
    } else {
        actor->process_timer--;
        if (actor->work_s[2] > 0) {
            actor->work_s[2]--;
        }
        if (actor->speed > 0.f) {
            if (actor->work_s[4] == actor->work_s[5]) {
                if (actor->work_s[5]) {
                    actor->work_s[5] = 0;
                } else {
                    actor->work_s[5] = DEG2SHORT_ANGLE(-10);
                }
            }
            if (!add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE2(0.5f), DEG2SHORT_ANGLE(5),
                                       DEG2SHORT_ANGLE(0.25f))) {
                actor->work_s[3] += DEG2SHORT_ANGLE(15);
                mID_insect_moveF(actor);
                actor->velocity.y += actor->_44.y;
                if (actor->process_timer < 0) {
                    actor->speed = 0.f;
                    actor->process_timer = (s16)RANDOM_F(76.f) + 4;
                } else if (actor->flags & 0x5e) {
                    actor->speed = 0.f;
                    actor->work_s[1] = actor->flags;
                }
                //! BUG: unused
                sin_s(actor->work_s[3]) <= 0.1 ? sin_s(actor->work_s[3]) : 0.1;
            }
        } else if (actor->process_timer < 0) {
            actor->speed = 0.95f;
            actor->process_timer = (s16)RANDOM_F(68.f) + 24;
            if (GETREG(NMREG, 4)) {
                okera_dig_down_process_init(actor, game);
            }
            if (actor->work_s[1] & 0x5e) {
                if (actor->work_s[1] & 0x40) {
                    actor->work_s[0] = qrand();
                } else if (actor->work_s[1] & 6) {
                    actor->work_s[0] = -actor->work_s[0];
                } else {
                    actor->work_s[0] = DEG2SHORT_ANGLE2(180) - actor->work_s[0];
                }
                actor->work_s[1] &= ~0x5e;
            } else {
                if (actor->work_s[2] == 0 && search_position_distanceXZ(&okera_base_pos, &actor->position) < 35.f) {
                    okera_dig_down_process_init(actor, game);
                } else {
                    actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(120.f));
                }
            }
        }
        add_calc_short_angle2(&actor->work_s[4], actor->work_s[5], CALC_EASE2(0.7f), DEG2SHORT_ANGLE(1.25f),
                              DEG2SHORT_ANGLE(0.25f));
    }
}

void okera_dig_down_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->work_s[5] = 0;
    actor->process = okera_dig_down_process;
    actor->process_timer = 10;
}

void okera_dig_down_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->process_timer-- < 0) {
        xyz_t p = actor->position;
        int v = (int)(RANDOM_F(3.f) + 3.f) | 0x4000;
        p.y = 45.f;
        Common_Get(clip.effect_clip)->effect_make_proc(84, p, 2, actor->rotation.y, game, -1, 0, v);
        actor->process_timer = 6;
    }
    if (!add_calc_short_angle2(&actor->rotation.x, DEG2SHORT_ANGLE(90), CALC_EASE2(0.5f), DEG2SHORT_ANGLE(5),
                               DEG2SHORT_ANGLE(1.25f))) {
        actor->position.y -= 0.2f;
        actor->work_s[3] += DEG2SHORT_ANGLE(12.5f);
        if (actor->position.y < 40.f) {
            okera_dig_wait_process_init(actor, game);
        }
    }
}

void okera_dig_wait_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->position = okera_base_pos;
    actor->process_timer = (s16)RANDOM_F(600.f) + 300;
    actor->process = okera_dig_wait_process;
}

void okera_dig_wait_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (GETREG(NMREG, 5)) {
        okera_dig_up_process_init(actor, game);
    }
    if (actor->process_timer-- < 0) {
        int i;
        okera_dig_up_process_init(actor, game);
        for (i = 3; i < 6; i++) {
            Common_Get(clip.effect_clip)->effect_make_proc(84, actor->position, 2, actor->rotation.y, game, -1, 0, i | 0x4000);
        }
    }
}

void minsect_okera_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    actor->process(actor, game);
    if (actor->process == okera_dig_wait_process && dist < 200.f) {
        sAdo_OngenPos((u32)actor, 68, &actor->position);
    }
    if (actor->process == okera_dig_up_process && dist < 200.f) {
        sAdo_OngenPos((u32)actor, 69, &actor->position);
    }

    //! NOTE: has to be written this way to match
    if (actor->process == okera_dig_wait_process || actor->process == okera_dig_down_process) {
        return;
    }
    minsect_tree_ObjCheck(actor);
    minsect_rock_ObjCheck(actor);
    minsect_kanban_BGCheck(actor);
    minsect_batta_ObjCheck(actor);
    minsect_garden_BGCheck(actor, 510.f, 370.f);
}

void minsect_okera_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->process == okera_dig_wait_process) {
        return;
    }
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y + (s16)(DEG2SHORT_ANGLE2(GETREG(TAKREG, 4) + 5.f) * sin_s(actor->work_s[3])),
                     actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(actor->work_s[4], 0, 0, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);
    if (actor->process != okera_dig_down_process) {
        minsect_draw_shadow(actor, game);
    }
}
