#include "ac_museum_insect_priv.h"

extern cKF_Skeleton_R_c cKF_bs_r_act_m_hirata_b, cKF_bs_r_act_m_nokogiri_b, cKF_bs_r_act_m_miyama_b,
    cKF_bs_r_act_m_okuwa_b;

cKF_Skeleton_R_c* kuwagata_model_tbl[] = { &cKF_bs_r_act_m_hirata_b, &cKF_bs_r_act_m_nokogiri_b,
                                           &cKF_bs_r_act_m_miyama_b, &cKF_bs_r_act_m_okuwa_b };

extern cKF_Animation_R_c cKF_ba_r_act_m_hirata_b, cKF_ba_r_act_m_nokogiri_b, cKF_ba_r_act_m_miyama_b,
    cKF_ba_r_act_m_okuwa_b;

cKF_Animation_R_c* kuwagata_anim_tbl[] = { &cKF_ba_r_act_m_hirata_b, &cKF_ba_r_act_m_nokogiri_b,
                                           &cKF_ba_r_act_m_miyama_b, &cKF_ba_r_act_m_okuwa_b };

xyz_t kuwagata_base_pos[4] = {
    { 166.f, 80.5f, 0.5f }, { 169.f, 66.5f, 5.0f }, { 318.f, 80.0f, 1.0f }, { 315.f, 65.0f, 5.5f }
};

void mi_kuwagata_rensa_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->work_s[5] = 0;
}
void mi_kuwagata_rensa(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    add_calc_short_angle2(&actor->work_s[4], actor->work_s[5], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f), DEG2SHORT_ANGLE(0.25f));
}

void mi_kuwagata_wait_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = (s16)RANDOM_F(200.f) + 40;
    cKF_SkeletonInfo_R_init_standard_repeat_speedsetandmorph(&actor->skeleton_state->keyframe, actor->skeleton_state->animation, NULL, 0.5f, 0.0f);
}

void mi_kuwagata_wait(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->process_timer < 0) {
        actor->work_s[5] = DEG2SHORT_ANGLE(-7);
        actor->process_timer = (s16)RANDOM_F(200.F) + 40;
        if (RANDOM_F(1.0f) > 0.7f || GETREG(NMREG, 1)) {
            mi_kuwagata_setupAction(actor, 3, game);
            return;
        } else if (RANDOM_F(1.0f) > 0.7f || GETREG(NMREG, 0)) {
            mi_kuwagata_setupAction(actor, 2, game);
            return;
        }
    }

    if (actor->work_s[4] == actor->work_s[5]) {
        actor->work_s[5] = 0;
    }
    actor->work_s[3]--;
    if (actor->work_s[3] < 0) {
        cKF_SkeletonInfo_R_play(&actor->skeleton_state->keyframe);
        if ((int)actor->skeleton_state->keyframe.frame_control.current_frame == 14) {
            actor->work_s[3] = (s16)RANDOM_F(356.F) + 4;
            if (actor->is_active == 0) {
                actor->work_s[3] *= 10;
            }
        } else if ((int)actor->skeleton_state->keyframe.frame_control.current_frame == 1) {
            actor->work_s[3] = (s16)RANDOM_F(1760.f) + 40;
            if (actor->is_active == 0) {
                actor->work_s[3] *= 10;
            }
        }
    }
    add_calc_short_angle2(&actor->work_s[4], actor->work_s[5], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f), DEG2SHORT_ANGLE(0.25f));
}

void mi_kuwagata_move_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    return;
}

void mi_kuwagata_move(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    return;
}

void mi_kuwagata_battle_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->flags & 4) {
        actor->speed = 0.05f;
    } else if (actor->flags & 8) {
        actor->speed = -0.05f;
    }
    actor->process_timer = (s16)RANDOM_F(120.f) + 60;
    actor->work_s[6] = 0x10;
}

void mi_kuwagata_battle(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    MUSEUM_INSECT_PRIVATE_DATA* priv;
    f32 v;
    switch (actor->insect_type) {
        case 0x15:
            priv = &MI_Control_Actor->privInsects[0x1d];
            break;
        case 0x1d:
            priv = &MI_Control_Actor->privInsects[0x15];
            break;
        case 0x1e:
            priv = &MI_Control_Actor->privInsects[0x1f];
            break;
        case 0x1f:
            priv = &MI_Control_Actor->privInsects[0x1e];
            break;
    }
    if (actor->work_s[6] == 0) {
        actor->work_s[6] = -1;
        priv->flags &= ~0xc;
        if (actor->speed >= 0.0f) {
            priv->flags |= 4;
        } else if (actor->speed < 0.0f) {
            priv->flags |= 8;
        }

        if (priv->process != mi_kuwagata_battle) {
            mi_kuwagata_setupAction(priv, 3, game);
        }
    }
    actor->process_timer--;
    actor->work_s[6]--;
    actor->work_s[1] += DEG2SHORT_ANGLE(GETREG(TAKREG, 0x14) + 30.f) >> 1;
    actor->rotation.z = DEG2SHORT_ANGLE2(GETREG(TAKREG, 0x15) * 0.1f + 2.0f) * sin_s(actor->work_s[1]);
    v = actor->position.y - kuwagata_base_pos[actor->work_s[0]].y;
    if (sin_s(actor->work_s[1]) <= 0.1 && sin_s(actor->work_s[1]) >= -0.1) {
        if (actor->work_s[5]) {
            actor->work_s[5] = 0;
        } else {
            actor->work_s[5] = DEG2SHORT_ANGLE(-7);
        }
    }
    actor->position.y += actor->speed * (cos_s(actor->work_s[1]) * 0.5f + 0.5f);
    actor->position.x = kuwagata_base_pos[actor->work_s[0]].x + (v * sin_s(actor->work_s[2]));
    if (actor->position.y > actor->_44.y + 2.0f) {
        actor->position.y = actor->_44.y + 2.0f;
        actor->flags &= ~0xc;
        actor->flags |= 0x8;
        mi_kuwagata_setupAction(actor, 0, game);
        priv->process_timer = 0x10;
    }

    if (actor->position.y < actor->_44.y - 2.0f) {
        actor->position.y = actor->_44.y - 2.0f;
        actor->flags &= ~0xc;
        actor->flags |= 0x4;
        mi_kuwagata_setupAction(actor, 0, game);
        priv->process_timer = 0x10;
    }
    if (actor->process_timer < 0) {
        mi_kuwagata_setupAction(actor, 0, game);
        priv->process_timer = 0x10;
    } else {
        actor->work_s[3]--;
        if (actor->work_s[3] < 0) {
            cKF_SkeletonInfo_R_play(&actor->skeleton_state->keyframe);
            if ((int)actor->skeleton_state->keyframe.frame_control.current_frame == 14) {
                actor->work_s[3] = (s16)RANDOM_F(356.f) + 4;
                if (actor->is_active == 0) {
                    actor->work_s[3] *= 10;
                }
            } else if ((int)actor->skeleton_state->keyframe.frame_control.current_frame == 1) {
                actor->work_s[3] = (s16)RANDOM_F(1760.f) + 40;
                if (actor->is_active == 0) {
                    actor->work_s[3] *= 10;
                }
            }
        }
        add_calc_short_angle2(&actor->work_s[4], actor->work_s[5], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f),
                              DEG2SHORT_ANGLE(0.25F));
    }
}

void mi_kuwagata_menace_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->work_s[5] = 3640 - DEG2SHORT_ANGLE(GETREG(NMREG, 0) * 0.01f);
    actor->process_timer = (s16)((s16)RANDOM_F(200.f) + 40) * 5;
    actor->work_s[3] = 10;
    cKF_SkeletonInfo_R_init_standard_repeat_speedsetandmorph(&actor->skeleton_state->keyframe, actor->skeleton_state->animation, NULL, 0.75f, 0.0f);
}

void mi_kuwagata_menace(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->work_s[5]) {
        add_calc(&actor->position.z, actor->_44.z + 3.f + GETREG(NMREG, 0xf) * 0.01f, CALC_EASE(0.3f), 0.75f, 0.05f);
    } else {
        add_calc(&actor->position.z, actor->_44.z, CALC_EASE(0.3f), 0.75f, 0.05f);
    }

    if (actor->process_timer < 0) {
        actor->work_s[5] = 0;
        if (actor->work_s[4] == 0) {
            if (RANDOM_F(1.f) > 0.7f || GETREG(NMREG, 1)) {
                mi_kuwagata_setupAction(actor, 3, game);
                return;
            } else {
                mi_kuwagata_setupAction(actor, 0, game);
                return;
            }
        }
    }

    actor->work_s[3]--;
    if (actor->work_s[3] < 0) {
        cKF_SkeletonInfo_R_play(&actor->skeleton_state->keyframe);
        if ((int)actor->skeleton_state->keyframe.frame_control.current_frame == 1) {
            cKF_Animation_R_c* anim = actor->skeleton_state->animation;
            cKF_SkeletonInfo_R_init_standard_repeat_speedsetandmorph(&actor->skeleton_state->keyframe, anim, NULL,
                                                                     (RANDOM_F(1.f) + 1.5f) * 0.5f, 0.f);
            if (RANDOM_F(1.f) > 0.9f) {
                actor->work_s[3] = (s16)RANDOM_F(1760.f) + 40;
            }
        }
    }
    add_calc_short_angle2(&actor->work_s[4], actor->work_s[5], CALC_EASE2(GETREG(NMREG, 0x5e) * 0.01f + 0.8f),
                          (s16)(DEG2SHORT_ANGLE(GETREG(NMREG, 0x5f) * 0.01f + 4.f) >> 1) >> 1, DEG2SHORT_ANGLE(0.25f));
}

void mi_kuwagata_attack_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    return;
}

void mi_kuwagata_attack(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    return;
}

void mi_kuwagata_setupAction(MUSEUM_INSECT_PRIVATE_DATA* actor, int r4, GAME* game) {
    static PRIV_INSECT_PROCESS init_proc[] = {
        mi_kuwagata_wait_init,   mi_kuwagata_move_init,   mi_kuwagata_menace_init,
        mi_kuwagata_battle_init, mi_kuwagata_attack_init, mi_kuwagata_rensa_init,
    };
    static PRIV_INSECT_PROCESS move_proc[] = {
        mi_kuwagata_wait,   mi_kuwagata_move,   mi_kuwagata_menace,
        mi_kuwagata_battle, mi_kuwagata_attack, mi_kuwagata_rensa,
    };
    actor->process = move_proc[r4];
    init_proc[r4](actor, game);
}

void minsect_kuwagata_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    switch (actor->insect_type) {
        case 0x15:
            actor->work_s[0] = 0;
            break;
        case 0x1d:
        case 0x1e:
        default:
            actor->work_s[0] = actor->insect_type - 0x1c;
            break;
    }
    if (actor->insect_type == 0x1e) {
        if (mMmd_InsectInfo(0x1f)) {
            actor->flags |= 0x10;
        }
    } else if (actor->insect_type == 0x15) {
        if (mMmd_InsectInfo(0x1d)) {
            actor->flags |= 0x10;
        }
    } else if (actor->insect_type == 0x1f) {
        if (mMmd_InsectInfo(0x1e)) {
            actor->flags |= 0x10;
        }
    } else if (actor->insect_type == 0x1d) {
        if (mMmd_InsectInfo(0x15)) {
            actor->flags |= 0x10;
        }
    }

    if (actor->flags & 0x10) {
        if (actor->insect_type == 0x1e || actor->insect_type == 0x15) {
            xyz_t p;
            xyz_t_sub(&kuwagata_base_pos[actor->work_s[0] + 1], &kuwagata_base_pos[actor->work_s[0]], &p);
            actor->work_s[2] = atans_table(p.y, -p.x);
        } else {
            xyz_t p;
            xyz_t_sub(&kuwagata_base_pos[actor->work_s[0] - 1], &kuwagata_base_pos[actor->work_s[0]], &p);
            actor->work_s[2] = atans_table(p.y, -p.x);
        }
    }
    actor->skeleton_state = &MI_Control_Actor->stag_skeletons[actor->work_s[0]];
    actor->skeleton_state->skeleton = kuwagata_model_tbl[actor->work_s[0]];
    actor->skeleton_state->animation = kuwagata_anim_tbl[actor->work_s[0]];
    cKF_SkeletonInfo_R_ct(&actor->skeleton_state->keyframe, actor->skeleton_state->skeleton, actor->skeleton_state->animation, actor->skeleton_state->joint, actor->skeleton_state->morph);
    cKF_SkeletonInfo_R_init_standard_repeat_speedsetandmorph(&actor->skeleton_state->keyframe, actor->skeleton_state->animation, NULL, 0.5f, 0.0f);
    cKF_SkeletonInfo_R_play(&actor->skeleton_state->keyframe);
    actor->work_s[3] = (s16)RANDOM_F(1760.f) + 40;
    actor->position = kuwagata_base_pos[actor->work_s[0]];
    actor->_44 = actor->position;
    actor->velocity = ZeroVec;
    actor->speed = 0.05f;
    actor->rotation = ZeroSVec;
    actor->work_s[1] = qrand();
    actor->process_timer = (s16)RANDOM_F(120.f) + 60;
    mi_kuwagata_setupAction(actor, 0, game);
}

