#include "ac_museum_insect_priv.h"

xyz_t ari_rail_pos[3] = { { 177.f, 45.f, -14.f }, { 242.f, 45.f, 10.f }, { 307.f, 45.f, -14.f } };

void minsect_ka_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    static xyz_t init_pos = { 280.f, 40.f, 320.f };
    actor->work_s[1] = qrand();
    actor->params.work_f[0] = 80.f;
    actor->position = init_pos;
    actor->position.x += RANDOM2_F(280.f);
    actor->position.y = actor->params.work_f[0] + sin_s(actor->work_s[1]) * 10.f;
    actor->position.z += RANDOM2_F(240.f);
    actor->velocity = ZeroVec;
    actor->speed = 0.7f;
    actor->_0C = 1.f;
    actor->_10 = 0.5f;
    actor->work_s[0] = qrand();
    actor->rotation.y = qrand();
    actor->_44 = ZeroVec;
    actor->work_s[2] = 0;
    actor->process_timer = (s16)RANDOM_F(1200.f) + 600;
}

void minsect_ka_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    xyz_t p = player->actor_class.world.position;
    MUSEUM_INSECT_ACTOR* priv;
    f32 dist = search_position_distanceXZ(&actor->position, &p);
    actor->process_timer--;
    add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE2(0.2f), DEG2SHORT_ANGLE(0.5f), DEG2SHORT_ANGLE(0.25f));
    if (actor->position.z > 540.f) {
        actor->work_s[0] = search_position_angleY(&actor->position, &p);
    } else if (actor->position.z < 60.f) {
        actor->work_s[0] = search_position_angleY(&actor->position, &p);
    } else if (actor->position.x > 340.f) {
        actor->work_s[0] = search_position_angleY(&actor->position, &p);
    } else if (actor->position.x < 60.f) {
        actor->work_s[0] = search_position_angleY(&actor->position, &p);
    }

    if (actor->work_s[2] == 0) {
        if (actor->process_timer < 0) {
            if (dist < 60.f) {
                actor->work_s[0] = search_position_angleY(&actor->position, &p);
                actor->process_timer = (s16)RANDOM_F(1200.f) + 600;
                actor->work_s[2] = 1;
            } else {
                actor->work_s[0] = qrand();
                actor->process_timer = (s16)RANDOM_F(1200.f) + 600;
            }
        }
    } else if (actor->work_s[2] == 1) {
        priv = MI_Control_Actor;
        actor->work_s[0] = search_position_angleY(&actor->position, &p);
        if (dist < 20.f) {
            if (mPlib_Check_stung_mosquito(MI_Control_Actor)) {
                actor->work_s[2] = 2;
            } else if (mDemo_Check(8, &priv->actor) == 0) {
                sAdo_OngenTrgStart(0x6a, &actor->position);
                mPlib_request_main_stung_mosquito_type1(MI_Control_Actor);
            }
        } else if (actor->process_timer < 0) {
            if (dist > 60.f) {
                actor->process_timer = (s16)RANDOM_F(1200.f) + 600;
            } else {
                actor->work_s[0] = qrand();
                actor->work_s[2] = 0;
            }
        }
        if (actor->process_timer < 0) {
            actor->process_timer = (s16)RANDOM_F(1200.f) + 600;
        }
    } else if (actor->work_s[2] == 2 && actor->process_timer < 0) {
        actor->work_s[0] = qrand();
        actor->process_timer = (s16)RANDOM_F(1200.f) + 600;
    }
    if (dist < 300.f) {
        sAdo_OngenPos((u32)actor, 0xcf, &actor->position);
    }
    mID_insect_moveF(actor);
    actor->_0C += actor->_10;
    if (minsect_mdl[actor->insect_type][(int)actor->_0C] == 0) {
        actor->_0C = 1.f;
    }
    actor->work_s[1] += DEG2SHORT_ANGLE(2.5f);
    actor->position.y = actor->params.work_f[0] + sin_s(actor->work_s[1]) * 10.f;
    minsect_tree_ObjCheck(actor);
    minsect_fly_BGCheck(actor, 600.0, 40.0);
    if (actor->flags & 0x10) {
        actor->position.z = 600.f;
    } else if (actor->flags & 8) {
        actor->work_s[0] = DEG2SHORT_ANGLE(RANDOM2_F(90.f));
    }
}

void minsect_ka_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);

    _texture_z_light_fog_prim_xlu(game->graph);
    OPEN_POLY_XLU_DISP(game->graph);
    gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][(int)actor->_0C]);
    CLOSE_POLY_XLU_DISP(game->graph);
    minsect_draw_shadow(actor, game);
}
