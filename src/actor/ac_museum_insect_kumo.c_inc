#include "ac_museum_insect_priv.h"

const xyz_t kumo_base_pos = { 330.f, 64.5f, 229.f };

const xyz_t kumo_top_pos = { 330.f, 90.f, 229.f };

const xyz_t kumo_bottom_pos = { 330.f, 54.f, 229.f };

void minsect_kumo_hide_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->speed = 0.165f;
}

void minsect_kumo_hide(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->position.y += actor->speed;
    if (actor->position.y > kumo_top_pos.y + 10.f) {
        actor->position.y = kumo_top_pos.y + 10.f;
    }
}

void minsect_kumo_up_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->speed = 0.165f;
    actor->process_timer = (s16)RANDOM_F(20.f) + 50;
    actor->_44.x = 10.f;
    actor->work_s[7] = actor->work_s[4];
}

void minsect_kumo_up(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    actor->position.y += actor->speed;
    if (actor->position.y > kumo_top_pos.y - 10.f) {
        actor->position.y = kumo_top_pos.y - 10.f;
        minsect_kumo_setupAction(actor, 0, game);
    } else if (actor->process_timer < 0) {
        actor->process_timer = (s16)RANDOM_F(20.f) + 50;
        actor->speed = 0.165f;
        actor->work_s[7] = actor->work_s[4];
    }
}

void minsect_kumo_down_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->_44.x = 60.f;
    actor->work_s[7] = DEG2SHORT_ANGLE(90);
    if (GETREG(NMREG, 0x14)) {
        actor->params.work_f[2] = GETREG(NMREG, 0x14) * 0.01f;
    } else {
        actor->params.work_f[2] = 1.8f;
    }
    actor->speed = GETREG(NMREG, 0x13) * 0.01f + 4.0f;
    actor->work_s[9] = 0;
}

void minsect_kumo_down(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (add_calc(&actor->speed, 0.f, CALC_EASE(GETREG(NMREG, 0x15) * 0.01f + 0.25f),
                 (GETREG(NMREG, 0x16) * 0.01f + 3.0f) * 0.5f, 0.05f) < (GETREG(NMREG, 0x1a) * 0.01f + 0.1f)) {
        if (!add_calc(&actor->params.work_f[2], 0.f, CALC_EASE(GETREG(NMREG, 0x17) * 0.01f + 0.5f),
                      (GETREG(NMREG, 0x18) * 0.01f + 0.08f) * 0.5f, 0.005f)) {
            actor->_44.x = 40.f;
            minsect_kumo_setupAction(actor, 0, game);
            return;
        }
        actor->position.y -= actor->speed;
    }
    if (actor->position.y < kumo_bottom_pos.y) {
        actor->position.y = kumo_bottom_pos.y;
    } else if (actor->position.y > kumo_top_pos.y - 10.f) {
        actor->position.y = kumo_top_pos.y - 10.f;
    }
}

void minsect_kumo_move_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    return;
}

void minsect_kumo_move(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->flags & 2) {
        if (actor->speed < 0.f) {
            actor->position.y += actor->speed;
            if (actor->position.y < kumo_bottom_pos.y + 10.f) {
                actor->flags |= 8;
                actor->flags &= ~2;
                actor->process_timer = (s16)RANDOM_F(360.f) + 40;
            }
        } else if (actor->flags & 0x10) {
            actor->position.y += actor->speed;
            if (actor->position.y > kumo_top_pos.y - 10.f) {
                actor->position.y = kumo_top_pos.y - 10.f;
                actor->flags |= 4;
                actor->flags &= ~2;
                actor->process_timer = (s16)RANDOM_F(360.f) + 40;
            }
            if (actor->process_timer % 12 == 0) {
                actor->flags &= ~0x10;
            }
        } else if (actor->process_timer % 12 == 0) {
            actor->flags |= 0x10;
        }
        if (actor->process_timer < 0) {
            actor->flags &= ~2;
            actor->process_timer = (s16)RANDOM_F(360.f) + 40;
        }
    } else if (actor->process_timer < 0) {
        if (actor->flags & 4) {
            if (RANDOM_F(1.f) > 0.5f) {
                minsect_kumo_setupAction(actor, 3, game);
                return;
            }
            actor->process_timer = (s16)RANDOM_F(20.f) + 40;
            actor->speed = -0.45f;
        } else if (actor->flags & 8 || RANDOM_F(1.f) > 0.5f) {
            if (RANDOM_F(1.f) > 0.9f) {
                minsect_kumo_setupAction(actor, 2, game);
                return;
            }
            actor->process_timer = (s16)RANDOM_F(20.f) + 50;
            actor->speed = 0.165f;
            actor->flags |= 0x10;
            actor->_44.x += 5.f;
            actor->work_s[7] = actor->work_s[4];
        } else {
            if (RANDOM_F(1.f) > 0.7f) {
                minsect_kumo_setupAction(actor, 0, game);
            } else {
                actor->process_timer = (s16)RANDOM_F(20.f) + 40;
                actor->speed = -0.45f;
            }
        }
        actor->flags &= ~0xc;
        actor->flags |= 2;
    }
}

void minsect_kumo_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (dist > 200.f) {
        minsect_kumo_setupAction(actor, 4, game);
    } else if (dist < 100.f && actor->process == minsect_kumo_hide) {
        minsect_kumo_setupAction(actor, 3, game);
    }
}

void minsect_kumo_furiko(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    f32 v, v2;
    if (actor->_44.x) {
        add_calc(&actor->params.work_f[1], actor->_44.x, CALC_EASE(0.7f), 0.75f, 0.05f);
    } else {
        add_calc(&actor->params.work_f[1], actor->_44.x, CALC_EASE(0.3f), 0.25f, 0.05f);
    }
    if (actor->params.work_f[1] == actor->_44.x) {
        actor->_44.x = 0.f;
    }

    add_calc_short_angle2(&actor->work_s[6], actor->work_s[7], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(1.25f), DEG2SHORT_ANGLE(0.25f));
    if (GETREG(NMREG, 0x10)) {
        v = GETREG(NMREG, 0x10) * 0.01f;
    } else {
        v = 0.2f;
    }
    if (GETREG(NMREG, 0x11)) {
        v2 = GETREG(NMREG, 0x11) * 0.01f;
    } else {
        v2 = 1.f;
    }
    actor->params.work_f[0] = MAX(1.f, kumo_top_pos.y - actor->position.y);
    actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(((v2 * actor->params.work_f[1] + 35.f) / actor->params.work_f[0]) * 1.8f * 0.5f);
    actor->rotation.x = sin_s(actor->work_s[0]) * DEG2SHORT_ANGLE2(v * actor->params.work_f[1]);
}

void minsect_kumo_wait_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = (s16)RANDOM_F(360.f) + 40;
}

void minsect_kumo_wait(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->process_timer < 0) {
        if (actor->position.y >= kumo_top_pos.y - 2.f && (RANDOM_F(1.f) > 0.2f || GETREG(NMREG, 0x14))) {
            minsect_kumo_setupAction(actor, 3, game);
        } else if (RANDOM_F(1.f) > 0.5f) {
            minsect_kumo_setupAction(actor, 1, game);
        } else {
            actor->process_timer = (s16)RANDOM_F(360.f) + 40;
        }
    }
}

void minsect_kumo_hineri(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->params.work_f[0] = MAX(1.f, kumo_top_pos.y - actor->position.y);
    actor->work_s[1] += (s16)DEG2SHORT_ANGLE2(35.f / actor->params.work_f[0] * 1.2f * 0.5f);
    actor->work_s[4] = 5461.f * sin_s(actor->work_s[1]);
}

void minsect_kumo_setupAction(MUSEUM_INSECT_PRIVATE_DATA* actor, int r4, GAME* game) {
    static PRIV_INSECT_PROCESS init_proc[] = { minsect_kumo_wait_init, minsect_kumo_move_init, minsect_kumo_up_init,
                                               minsect_kumo_down_init, minsect_kumo_hide_init };
    static PRIV_INSECT_PROCESS move_proc[] = { minsect_kumo_wait, minsect_kumo_move, minsect_kumo_up, minsect_kumo_down,
                                               minsect_kumo_hide };
    // unused, but has to be here because of data pooling
    static f32 scaleX_table[] = { 1.15, 0.5f, 1.15f, 0.5f, 1.15f, 0.5f, 1.15f };
    actor->process = move_proc[r4];
    init_proc[r4](actor, game);
}

void minsect_kumo_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->position = kumo_base_pos;
    actor->velocity.x = 0.01f;
    actor->velocity.y = 0.01f;
    actor->velocity.z = 0.01f;
    actor->params.work_f[1] = 0.f;
    actor->_44.x = 0.f;
    actor->rotation = ZeroSVec;
    actor->process_timer = (s16)RANDOM_F(360.f) + 40;
    actor->work_s[1] = qrand();
    actor->work_s[3] = (s16)(RANDOM_F(5.f) * 60.f) + 307;
    actor->work_s[5] = (s16)RANDOM_F(360.f) + 40;
    minsect_kumo_setupAction(actor, 4, game);
}

void minsect_kumo_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    GAME_PLAY* play = (GAME_PLAY*)game;
    minsect_kumo_check_player(actor, game);
    minsect_kumo_furiko(actor, game);
    if (actor->process != minsect_kumo_hide) {
        minsect_kumo_hineri(actor, game);
    }
    if (GETREG(NMREG, 1) && (play->game_frame & 7) == 0) {
        xyz_t p = actor->position;
        p = actor->position;
        p.y += GETREG(NMREG, 5) * 0.01f;
        Common_Get(clip.effect_clip)->effect_make_proc(101, p, 1, 0, game, 0x5843, 2, 0);
        Common_Get(clip.effect_clip)->effect_make_proc(101, actor->position, 1, 0, game, 0x5843, 1, 0);
        Common_Get(clip.effect_clip)->effect_make_proc(101, kumo_base_pos, 1, 0, game, 0x5843, 3, 0);
        Common_Get(clip.effect_clip)->effect_make_proc(101, kumo_top_pos, 1, 0, game, 0x5843, 1, 0);
    }
    actor->process(actor, game);
}

void minsect_kumo_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y + actor->params.work_f[0], actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(0, actor->work_s[6], 0, MTX_MULT);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(0, -actor->work_s[6], 0, MTX_MULT);
    Matrix_translate(0.f, -actor->params.work_f[0], 0.f, MTX_MULT);
    Matrix_rotateXYZ(0, actor->work_s[4], 0, MTX_MULT);
    Matrix_translate(0.f, 0.f, -2.5f, MTX_MULT);
    Matrix_rotateXYZ(DEG2SHORT_ANGLE(-90), DEG2SHORT_ANGLE2(180), 0, MTX_MULT);
    Matrix_scale(actor->velocity.x, actor->velocity.y, actor->velocity.z, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    if (actor->work_s[8]) {
        gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    } else {
        gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][1]);
    }
    CLOSE_DISP(game->graph);

    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y + actor->params.work_f[0], actor->position.z + (GETREG(NMREG, 0x5F)) * 0.01f, MTX_LOAD);
    Matrix_rotateXYZ(0, actor->work_s[6], 0, MTX_MULT);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(0, -actor->work_s[6], 0, MTX_MULT);
    Matrix_translate(0.0f, -actor->params.work_f[0], 0.0f, MTX_MULT);
    Matrix_rotateXYZ(0, actor->work_s[4], 0, MTX_MULT);
    if (GETREG(NMREG, 5)) {
        Matrix_translate(GETREG(NMREG, 4) * 0.001f, GETREG(NMREG, 5) * 0.01f, GETREG(NMREG, 6) * 0.01f, MTX_MULT);
    } else {
        Matrix_translate(0.0f, 6.5f, 0.f, MTX_MULT);
    }

    if (GETREG(NMREG, 7)) {
        Matrix_scale(1.5f, actor->params.work_f[0] / ((kumo_top_pos.y - kumo_base_pos.y) - (GETREG(NMREG, 7) * 0.01f)), 1.f, MTX_MULT);
    } else {
        Matrix_scale(2.f, actor->params.work_f[0] / ((kumo_top_pos.y - kumo_base_pos.y) - 10.f), 1.f, MTX_MULT);
    }
    Matrix_translate(0.f, -8.7f + GETREG(NMREG, 0x5d) * 0.01f, 1.f + GETREG(NMREG, 0x5e) * 0.01f, MTX_MULT);
    Matrix_rotateXYZ(DEG2SHORT_ANGLE(-90), DEG2SHORT_ANGLE2(180), 0, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][2]);
    minsect_draw_shadow(actor, game);
    CLOSE_DISP(game->graph);
}
