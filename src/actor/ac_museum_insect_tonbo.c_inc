#include "ac_museum_insect_priv.h"

xyz_t tonbo_rock_pos[6] = { { 215.f, 68.f, 403.f }, { 232.f, 60.f, 381.f }, { 372.f, 65.f, 482.f },
                            { 390.f, 68.f, 469.f }, { 328.f, 72.f, 501.f }, { 351.f, 72.f, 501.f } };

void minsect_tonbo_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->velocity = ZeroVec;
    actor->rotation = ZeroSVec;
    actor->rotation.y = qrand();
    actor->work_s[0] = qrand();
    actor->work_s[1] = 0;
    if (actor->is_active == 1) {
        static const xyz_t init_center_pos = { 280.f, 100.f, 440.f };
        actor->position = init_center_pos;
        actor->position.x += RANDOM2_F(460.f);
        actor->position.y = RANDOM_F(30.f) + 100.f;
        actor->position.z += RANDOM2_F(280.f);
        actor->_44 = actor->position;
        actor->_10 = 0.5f;
        actor->_0C = 1.0f;
        actor->work_s[2] = 0;
        actor->work_s[3] = qrand();
        minsect_tonbo_normal_process_init(actor, game);
    } else {
        actor->work_s[2] = actor->insect_type - 9;
        MI_Control_Actor->perch_occupancy_masks[2] |= (1 << actor->work_s[2]);
        actor->_44 = actor->position = tonbo_rock_pos[actor->work_s[2]];
        minsect_tonbo_rock_wait_process_init(actor, game);
    }
}

void mi_tonbo_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (dist < 80.f) {
        if (player->actor_class.speed > 1.4f) {
            actor->work_s[9] += (s16)((dist / 80.f) * 8.0f);
        } else if (player->actor_class.speed > 5.0f) {
            actor->work_s[9] += (s16)((dist / 80.f) * 20.0f);
        }
    }
}

BOOL minsect_tonbo_bg_check(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->flags & 0x9e) {
        if (actor->work_s[1] & 0x80) {
            if (RANDOM_F(1.0f) >= 0.5f) {
                actor->work_s[0] += (s16)(DEG2SHORT_ANGLE2(RANDOM_F(90)) + DEG2SHORT_ANGLE(90));
            } else {
                actor->work_s[0] -= (s16)(DEG2SHORT_ANGLE(RANDOM_F(90)) + DEG2SHORT_ANGLE(90));
            }
            actor->work_s[1] = 0;
            actor->speed = 0.0f;
            return TRUE;
        }
        if ((actor->flags & 8) == 0 || (actor->flags & 6)) {
            if (actor->work_s[1] & 2) {
                actor->work_s[0] = DEG2SHORT_ANGLE(90);
                actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
            } else if (actor->work_s[1] & 4) {
                actor->work_s[0] = DEG2SHORT_ANGLE(-90);
                actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
            } else if (actor->work_s[1] & 0x10) {
                actor->work_s[0] = DEG2SHORT_ANGLE(-180);
                actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
            } else if (actor->work_s[1] & 8) {
                actor->work_s[0] = (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
            } else {
                actor->work_s[0] += DEG2SHORT_ANGLE2(RANDOM2_F(90));
            }
            actor->work_s[1] = 0;
            actor->speed = 0.0f;
            return TRUE;
        }
    }
    return FALSE;
}

void minsect_tonbo_near_target_set(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    int i;
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    for (i = 0; i <= 6; i++) {
        f32 dist;
        if (i >= 6) {
            dist = search_position_distance(&actor->position, &player->actor_class.world.position);
        } else {
            dist = search_position_distance(&actor->position, &tonbo_rock_pos[i]);
        }
        if (dist < 80.f && (MI_Control_Actor->perch_occupancy_masks[2] & (1 << actor->work_s[2])) == 0) {
            minsect_tonbo_aim_rock_process_init(actor, game);
        }
    }
}

void minsect_tonbo_rock_target_set(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game, xyz_t* p) {
    xyz_t arr[2] = { { 0.f, 22.f, 0.f }, { 0.f, 27.f, 0.f } };
    float g_f[2] = { 1.f, -12.f };
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    if (actor->work_s[2] >= 6) {
        int gender = Common_Get(now_private)->gender;
        search_position_distance(&actor->position, &actor->_44);
        *p = player->head_pos;
        if (GETREG(NMREG, 0x11)) {
            arr[gender].y = GETREG(NMREG, 0x11) * 0.01f;
        }

        arr[gender].x += sin_s(player->actor_class.shape_info.rotation.y) * g_f[gender];
        arr[gender].z += cos_s(player->actor_class.shape_info.rotation.y) * g_f[gender];

        p->x += arr[gender].x;
        p->y += arr[gender].y;
        p->z += arr[gender].z;
        if (actor->process == minsect_tonbo_rock_wait_process && actor->work_s[2] >= 6) {
            xyz_t pp;
            xyz_t_sub(&player->feel_pos, &player->head_pos, &pp);
            actor->work_s[7] = atans_table(pp.y, pp.z);
            actor->work_s[8] = atans_table(pp.y, -pp.x);
        } else if (actor->process != minsect_tonbo_rock_process || actor->work_s[2] < 6) {
            actor->work_s[7] = 0;
            actor->work_s[8] = 0;
        }
    } else {
        *p = tonbo_rock_pos[(int)actor->work_s[2]];
    }
}

// UNUSED
void minsect_tonbo_suprised_near_player() {
    extern _strip(f32);
    _strip(75.f);
    _strip(6.f);
    _strip(55.f);
}

BOOL minsect_tonbo_suprised_rest_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->work_s[2] >= 6) {
        actor->work_s[5] = 1;
        minsect_tonbo_fly_process_init(actor, game);
        return TRUE;
    }
    return FALSE;
}

f32 minsect_tonbo_acc_change(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    f32 v;
    if (GETREG(NMREG, 5)) {
        return GETREG(NMREG, 5);
    }

    if (GETREG(NMREG, 4)) {
        v = GETREG(NMREG, 4);
    } else {
        v = 55.f;
    }
    if (actor->insect_type != 10) {
        if (actor->insect_type == 9) {
            v *= 0.9f;
        } else if (actor->insect_type == 11) {
            v *= 1.5f;
        } else if (actor->insect_type == 12) {
            v *= 1.7f;
        }
    }
    return v;
}

void minsect_tonbo_max_speed_set(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    if (actor->insect_type == 10) {
        actor->params.work_f[1] = RANDOM_F(1.0f) + 1.75f;
        actor->process_timer = 0;
    } else if (actor->insect_type == 9) {
        actor->params.work_f[1] = (RANDOM_F(1.0f) + 1.75f) * 0.9f;
        actor->process_timer = 0;
    } else if (actor->insect_type == 11) {
        actor->params.work_f[1] = (RANDOM_F(1.0f) + 1.75f) * 1.5f;
        actor->process_timer = 0;
    } else if (actor->insect_type == 12) {
        actor->params.work_f[1] = (RANDOM_F(1.0f) + 1.75f) * 1.7f;
        actor->process_timer = 0;
    }
}

f32 minsect_tonbo_aim_distance_set(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    f32 v;
    if (GETREG(NMREG, 2)) {
        v = (GETREG(NMREG, 2) + RANDOM_F(GETREG(NMREG, 3))) * 4.0f;
    } else if (actor->insect_type == 12) {
        v = (RANDOM_F(5.0f) + 41.25f) * 4.0f;
    } else {
        v = (RANDOM_F(5.0f) + 27.5f) * 4.0f;
    }
    if (actor->insect_type != 10) {
        if (actor->insect_type == 9) {
            v *= 0.9f;
        } else if (actor->insect_type == 11) {
            v *= 1.1f;
        } else if (actor->insect_type == 12) {
            v *= 1.7f;
        }
    }
    return v;
}

void minsect_tonbo_aim_angle_check(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    f32 v;
    xyz_t b;
    if (GETREG(NMREG, 1)) {
        v = GETREG(NMREG, 1);
    } else {
        v = 30.f;
    }
    b = actor->position;
    b.x += sin_s(actor->work_s[0]) * v;
    b.z += cos_s(actor->work_s[0]) * v;
    if (b.x < 80.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(90);
    } else if (b.x > 480.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(-90);
        actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
    } else if (b.z > 560.f) {
        actor->work_s[0] = DEG2SHORT_ANGLE(-180);
        actor->work_s[0] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
    } else if (b.z < 80.f) {
        actor->work_s[0] = (s16)DEG2SHORT_ANGLE2(RANDOM2_F(90));
    }
}

void minsect_tonbo_normal_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    minsect_tonbo_max_speed_set(actor);
    actor->speed = 0.0f;
    if (actor->work_s[5]) {
        actor->params.work_f[1] *= 1.5f;
        actor->speed = actor->params.work_f[1] / 3.0f;
    }
    actor->work_s[5] = 0;
    actor->work_s[4] = 0;
    actor->process = minsect_tonbo_normal_process;
}

void minsect_tonbo_normal_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->work_s[4] != 2 && minsect_tonbo_bg_check(actor, game)) {
        if (RANDOM_F(1.0f) > 0.9f) {
            minsect_tonbo_aim_rock_process_init(actor, game);
            return;
        }
        actor->work_s[4] = 2;
        if (RANDOM_F(1.0f) > 0.9f) {
            minsect_tonbo_near_target_set(actor, game);
            return;
        }
        actor->process_timer = 0;
    }

    switch (actor->work_s[4]) {
        case 0: {
            f32 acc;
            add_calc(&actor->speed, actor->params.work_f[1], CALC_EASE(0.5f), 0.3f, 0.05f);
            acc = minsect_tonbo_acc_change(actor);
            if (ABS(actor->position.x - actor->_44.x) <= acc && ABS(actor->position.z - actor->_44.z) <= acc) {
                actor->work_s[4] = 1;
            }
        } break;
        case 1: {
            if (!add_calc(&actor->speed, 0.0f, CALC_EASE(0.1f), 0.25f, 0.05f)) {
                actor->work_s[4] = 2;
                if (actor->flags & 8) {
                    actor->work_s[0] = DEG2SHORT_ANGLE(RANDOM2_F(90.f));
                } else {
                    actor->work_s[0] += DEG2SHORT_ANGLE(RANDOM2_F(90.f));
                }
                minsect_tonbo_aim_angle_check(actor);
                if (actor->work_s[6]) {
                    if (RANDOM_F(1.0f) > 0.9f) {
                        minsect_tonbo_aim_rock_process_init(actor, game);
                    } else if (RANDOM_F(1.0f) > 0.9f) {
                        minsect_tonbo_near_target_set(actor, game);
                    }
                }
                actor->work_s[1] = 0;
            }
        } break;
        case 2: {
            if (!add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE2(0.6f), DEG2SHORT_ANGLE(15),
                                       DEG2SHORT_ANGLE(0.25f))) {
                actor->process_timer--;
                if (actor->process_timer < 0) {
                    f32 v;
                    minsect_tonbo_max_speed_set(actor);
                    v = minsect_tonbo_aim_distance_set(actor);
                    actor->_44 = actor->position;
                    actor->_44.y += RANDOM2_F(30.f) + 5.0f;
                    actor->_44.y = MAX(100.f, MIN(125.f, actor->_44.y));
                    actor->_44.x += v * sin_s(actor->rotation.y);
                    actor->_44.z += v * cos_s(actor->rotation.y);
                    actor->work_s[6] = 1;
                    actor->work_s[4] = 0;
                }
            }
        } break;
    } // end switch

    minsect_tonbo_MoveF(actor);
}

void minsect_tonbo_aim_rock_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->work_s[2] = RANDOM_F(16.0f);
    if (actor->work_s[2] >= 6) {
        actor->work_s[2] = 6;
    }
    while (MI_Control_Actor->perch_occupancy_masks[2] & (1 << actor->work_s[2])) {
        if (actor->work_s[2] < 6) {
            actor->work_s[2]++;
        } else {
            actor->work_s[2] = 0;
        }
    }
    MI_Control_Actor->perch_occupancy_masks[2] |= (1 << actor->work_s[2]);
    if (actor->insect_type == 12) {
        actor->params.work_f[1] = (RANDOM_F(1.f) + 1.75f) * 1.7f;
        actor->process_timer = 0;
    } else {
        actor->params.work_f[1] = (RANDOM_F(1.f) + 1.75f);
        actor->process_timer = 0;
    }
    actor->speed = 0.0f;
    actor->work_s[4] = 0;
    actor->process = minsect_tonbo_aim_rock_process;
}

void minsect_tonbo_aim_rock_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p;
    minsect_tonbo_rock_target_set(actor, game, &p);
    if (actor->work_s[4] != 2 && minsect_tonbo_bg_check(actor, game)) {
        actor->work_s[4] = 2;
        actor->process_timer = 0;
    }
    switch (actor->work_s[4]) {
        case 0: {
            f32 acc;
            add_calc(&actor->speed, actor->params.work_f[1], CALC_EASE(0.5f), 0.3f, 0.05f);
            acc = minsect_tonbo_acc_change(actor);
            if (ABS(actor->position.x - actor->_44.x) <= acc && ABS(actor->position.z - actor->_44.z) <= acc) {
                actor->work_s[4] = 1;
            }
        } break;
        case 1: {
            if (!add_calc(&actor->speed, 0.0f, CALC_EASE(0.1f), 0.25f, 0.05f)) {
                actor->work_s[4] = 2;
                if (actor->flags & 8) {
                    actor->work_s[0] = DEG2SHORT_ANGLE(RANDOM2_F(90.f));
                    minsect_tonbo_aim_angle_check(actor);
                } else if (RANDOM_F(1.0f) > 0.8f) {
                    MI_Control_Actor->perch_occupancy_masks[2] &= ~(1 << actor->work_s[2]);
                    minsect_tonbo_normal_process_init(actor, game);
                    return;
                } else {
                    actor->work_s[0] = search_position_angleY(&actor->position, &p);
                    actor->work_s[0] += DEG2SHORT_ANGLE2(RANDOM2_F(45.f));
                }
                actor->work_s[1] = 0;
            }
        } break;
        case 2: {
            if (!add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE2(0.6f), DEG2SHORT_ANGLE(15),
                                       DEG2SHORT_ANGLE(0.025f))) {
                actor->process_timer--;
                if (actor->process_timer < 0) {
                    f32 v, s;
                    v = search_position_distanceXZ(&actor->position, &p);
                    s = (actor->position.y - p.y) * sin_s(DEG2SHORT_ANGLE(30));
                    if (v < 50.f && v > s) {
                        minsect_tonbo_rock_process_init(actor, game);
                    } else {
                        minsect_tonbo_max_speed_set(actor);
                        v = minsect_tonbo_aim_distance_set(actor);
                        actor->_44 = actor->position;
                        actor->_44.y += RANDOM2_F(30.f) + 5.0f;
                        actor->_44.y = MAX(100.f, MIN(125.f, actor->_44.y));
                        actor->_44.x += v * sin_s(actor->rotation.y);
                        actor->_44.z += v * cos_s(actor->rotation.y);
                        actor->work_s[4] = 0;
                    }
                }
            }
        } break;
    } // end switch

    minsect_tonbo_MoveF(actor);
}

void minsect_tonbo_rock_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p;
    minsect_tonbo_rock_target_set(actor, game, &p);
    actor->_44 = p;
    actor->work_s[0] = search_position_angleY(&actor->position, &p);
    actor->speed = 2.0f;
    actor->process = minsect_tonbo_rock_process;
}

void minsect_tonbo_rock_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p;
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    minsect_tonbo_rock_target_set(actor, game, &p);
    actor->_44 = p;
    if ((!player->actor_class.speed || (!minsect_tonbo_suprised_rest_player(actor, game))) &&
        !(player->actor_class.world.position.x > 500.f && actor->work_s[2] >= 6 &&
          minsect_tonbo_suprised_rest_player(actor, game)) &&
        !add_calc_short_angle2(&actor->rotation.y, actor->work_s[0], CALC_EASE2(0.6f), DEG2SHORT_ANGLE(15),
                               DEG2SHORT_ANGLE(0.025f))) {
        chase_xyz_t(&actor->position, &actor->_44, actor->speed);
        add_calc(&actor->speed, 0.25f, CALC_EASE(0.1f), 0.25f, 0.05f);
        add_calc_short_angle2(&actor->work_s[3], DEG2SHORT_ANGLE(0), CALC_EASE2(0.3f), DEG2SHORT_ANGLE(15),
                              DEG2SHORT_ANGLE(0.025f));
        if (actor->work_s[2] >= 6) {
            f32 v = 6.0f;
            f32 dist = search_position_distance(&actor->position, &actor->_44);
            if (GETREG(NMREG, 0x10)) {
                v = GETREG(NMREG, 0x10) * 0.01f;
            }
            if (dist < v) {
                s16 s;
                xyz_t p2;
                v = 0.6f;
                xyz_t_sub(&player->feel_pos, &player->head_pos, &p2);
                if (GETREG(NMREG, 0x12)) {
                    v = GETREG(NMREG, 0x12) * 0.01f;
                }
                if (chase_s(&actor->work_s[7], atans_table(p2.y, p2.z), (s16)DEG2SHORT_ANGLE2(v)) &&
                    chase_s(&actor->work_s[8], atans_table(p2.y, -p2.x), (s16)DEG2SHORT_ANGLE2(v)) &&
                    F32_IS_ZERO(actor->position.x - p.x) && F32_IS_ZERO(actor->position.y - p.y) &&
                    F32_IS_ZERO(actor->position.z - p.z)) {
                    minsect_tonbo_rock_wait_process_init(actor, game);
                }
            }
        } else if (F32_IS_ZERO(actor->position.x - p.x) && F32_IS_ZERO(actor->position.y - p.y) &&
                   F32_IS_ZERO(actor->position.z - p.z)) {
            minsect_tonbo_rock_wait_process_init(actor, game);
        }
    }
}

void minsect_tonbo_rock_wait_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process = minsect_tonbo_rock_wait_process;
    actor->_10 = 0.0f;
    actor->process_timer = (s16)RANDOM_F(540.f) + 60;
}

void minsect_tonbo_rock_wait_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p;
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    minsect_tonbo_rock_target_set(actor, game, &p);
    actor->process_timer--;
    if (actor->_10 > 0.0f) {
        if ((int)actor->_0C == 1 && actor->process_timer < 0) {
            actor->_10 = 0.0f;
            actor->process_timer = (s16)RANDOM_F(540.f) + 60;
            if (actor->is_active == 0) {
                actor->process_timer *= 5;
            }
        }
    } else if (actor->process_timer < 0) {
        if (actor->is_active == 1 && RANDOM_F(1.0f) > 0.75f) {
            minsect_tonbo_fly_process_init(actor, game);
        } else {
            actor->_10 = 0.5f;
            actor->process_timer = 0x10;
        }
    }

    mi_tonbo_check_player(actor, game);
    actor->work_s[9]--;
    if (actor->work_s[9] < 0) {
        actor->work_s[9] = 0;
    }
    if (actor->work_s[9] > 1600) {
        actor->work_s[9] = 1600;
    }
    if (actor->is_active) {
        if (actor->work_s[9] > 150) {
            minsect_tonbo_fly_process_init(actor, game);
            actor->work_s[9] = 0;
        }
    } else {
        if (actor->work_s[9] > 1500) {
            minsect_tonbo_fly_process_init(actor, game);
            actor->work_s[9] = 0;
        }
    }
    if (!(player->actor_class.speed > 1.9f && minsect_tonbo_suprised_rest_player(actor, game)) &&
        !(player->actor_class.world.position.x > 500.f && minsect_tonbo_suprised_rest_player(actor, game))) {
        if (actor->work_s[2] >= 6) {
            actor->rotation.y += player->actor_class.shape_info.rotation.y - (player->old_shape_angle.y);
        }
        actor->position = p;
    }
}

void minsect_tonbo_fly_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    f32 v;
    MI_Control_Actor->perch_occupancy_masks[2] &= ~(1 << actor->work_s[2]);
    actor->params.work_f[1] = RANDOM_F(1.0f) + 1.75f;
    v = minsect_tonbo_aim_distance_set(actor);
    v *= 0.3f;
    minsect_tonbo_max_speed_set(actor);
    actor->params.work_f[1] *= 0.7f;
    actor->_44 = actor->position;
    actor->_44.y += RANDOM_F(10.f) + 10.f;
    actor->_44.y = MAX(100.f, MIN(125.f, actor->_44.y));
    actor->_44.x += v * sin_s(actor->rotation.y);
    actor->_44.z += v * cos_s(actor->rotation.y);
    actor->process = minsect_tonbo_fly_process;
    actor->process_timer = 0;
    actor->speed = 0.0f;
    actor->_10 = 0.5f;
    actor->work_s[5] = 0;
    actor->work_s[6] = 0;
}

void minsect_tonbo_fly_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (minsect_tonbo_bg_check(actor, game)) {
        actor->_44.y = MAX(100.f, MIN(125.f, actor->_44.y));
        minsect_tonbo_normal_process_init(actor, game);
    } else {
        f32 v;
        minsect_tonbo_MoveF(actor);
        add_calc(&actor->speed, actor->params.work_f[1], CALC_EASE(0.7f), 0.5f, 0.5f);
        v = minsect_tonbo_acc_change(actor);
        if (ABS(actor->position.y - actor->_44.y) <= 10.f && ABS(actor->position.x - actor->_44.x) <= v &&
            ABS(actor->position.z - actor->_44.z) <= v) {
            minsect_tonbo_normal_process_init(actor, game);
            actor->work_s[4] = 1;
        }
    }
}

void minsect_tonbo_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->is_active = get_now_mind_flag(actor, game);
    actor->process(actor, game);
    if (actor->process != minsect_tonbo_rock_process && actor->process != minsect_tonbo_rock_wait_process &&
        actor->process != minsect_tonbo_fly_process) {
        actor->work_s[3] += 910;
        actor->params.work_f[0] = 4.0f * sin_s(actor->work_s[3]);
    } else {
        add_calc0(&actor->params.work_f[0], 0.1f, 0.1f);
        actor->work_s[3] = 0;
    }
    minsect_tree_ObjCheck(actor);
    minsect_fly_BGCheck(actor, 600.0f, 280.0f);
    if (actor->flags & 0x10) {
        actor->position.z = 600.f;
    }
    if (actor->flags & 0x9e) {
        actor->work_s[1] = actor->flags;
    }
    actor->_0C += actor->_10;
    if (!minsect_mdl[actor->insect_type][(int)actor->_0C]) {
        actor->_0C = 1.0f;
    }
}

void minsect_tonbo_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t arr[2] = { { 0.f, 22.f, 0.f }, { 0.f, 27.f, 0.f } };
    float g_f[2] = { 1.f, -12.f };
    search_position_distance(&actor->position, &actor->_44);
    _texture_z_light_fog_prim_xlu(game->graph);
    _texture_z_light_fog_prim(game->graph);
    if (((actor->process == minsect_tonbo_rock_wait_process) && (actor->work_s[2] >= 6)) ||
        ((actor->process == minsect_tonbo_rock_process && (actor->work_s[2] >= 6))) || GETREG(NMREG, 0x13)) {
        int gender = Common_Get(now_private)->gender;
        PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
        if (GETREG(NMREG, 0x11)) {
            arr[gender].y = GETREG(NMREG, 0x11) * 0.01f;
        }
        arr[gender].x += g_f[gender] * sin_s(player->actor_class.shape_info.rotation.y);
        arr[gender].z += g_f[gender] * cos_s(player->actor_class.shape_info.rotation.y);
        Matrix_translate(actor->position.x - arr[gender].x, actor->params.work_f[0] + (actor->position.y - arr[gender].y),
                         actor->position.z - arr[gender].z, MTX_LOAD);
        Matrix_rotateXYZ(actor->work_s[7], 0, actor->work_s[8], MTX_MULT);
        Matrix_translate(arr[gender].x, arr[gender].y, arr[gender].z, MTX_MULT);
    } else {
        Matrix_translate(actor->position.x, actor->position.y + actor->params.work_f[0], actor->position.z, MTX_LOAD);
    }
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);

    OPEN_POLY_XLU_DISP(game->graph);
    gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][(int)actor->_0C]);
    CLOSE_POLY_XLU_DISP(game->graph);

    OPEN_DISP(game->graph);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);
    minsect_draw_shadow(actor, game);
}

void minsect_tonbo_MoveF(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    xyz_t p = actor->_44;
    f32 v = search_position_distance(&actor->position, &actor->_44);
    if (actor->insect_type == 12) {
        if (actor->flags & 0x1e && !(actor->flags & 8)) {
            v = 0.0f;
        } else {
            v = -v * 0.01f;
        }
        p.y += v;
    } else {
        if (actor->flags & 0x1e && !(actor->flags & 8)) {
            v = 0.0f;
        } else {
            v = -v * 0.15f;
        }
        p.y += v;
    }
    chase_xyz_t(&actor->position, &p, actor->speed);
}
