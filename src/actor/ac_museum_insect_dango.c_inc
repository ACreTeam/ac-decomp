#include "ac_museum_insect_priv.h"

xyz_t rail_pos[6] = { { 368.f, 45.f, 467.f }, { 363.f, 45.f, 482.f }, { 374.f, 45.f, 499.f },
                      { 393.f, 45.f, 502.f }, { 407.f, 45.f, 488.f }, { 407.f, 45.f, 469.f } };

void mi_dango_defence_anime(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    static f32 scale_table[] = { 1.f, 0.85f, 1.15f, 0.75f, 1.05f, 0.65f, 0.95f };
    if (actor->work_s[7] < 7 && actor->work_s[7] >= 0) {
        if (chase_f(&actor->params.work_f[0], scale_table[actor->work_s[7]], 0.115f) == TRUE) {
            actor->work_s[7]--;
        }
    } else {
        actor->work_s[7]--;
    }
    if (actor->work_s[7] < 0) {
        actor->work_s[7] = -1;
    }
}

void mi_dango_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (dist < 80.f) {
        if (player->actor_class.speed > 1.4f) {
            actor->work_s[5] += (s16)((dist / 80.f) * 8.f);
        } else if (player->actor_class.speed > 5.f) {
            actor->work_s[5] += (s16)((dist / 80.f) * 20.f);
        }
    }
}

void mi_dango_move_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = (s16)RANDOM_F(560.f) + 40;
}

void mi_dango_move(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->work_s[6] = 0;
    actor->process_timer--;
    if (F32_IS_ZERO(actor->speed)) {
        if (actor->process_timer < 0) {
            actor->speed = RANDOM_F(0.1f) + 0.065f;
            actor->process_timer = (s16)RANDOM_F(560.f) + 40;
        }
    } else {
        if (actor->process_timer < 0) {
            actor->process_timer = (s16)RANDOM_F(260.f) + 40;
            actor->speed = 0.f;
        }
        chase_angle2(&actor->rotation.y, actor->work_s[2], actor->work_s[4]);
        if (actor->flags & 2) {
            xyz_t p;
            xyz_t_sub(&rail_pos[actor->work_s[1]], &actor->position, &p);
            actor->work_s[2] = atans_table(p.z, p.x);
            if (ABS((s16)(actor->rotation.y - actor->work_s[2])) < DEG2SHORT_ANGLE(1)) {
                actor->flags &= ~2;
            } else {
                mID_insect_moveF(actor);
            }
        } else {
            xyz_t p;
            xyz_t_sub(&rail_pos[actor->work_s[1]], &actor->position, &p);
            actor->work_s[2] = atans_table(p.z, p.x);
            if (!chase_xyz_t(&actor->position, &rail_pos[actor->work_s[1]], actor->speed)) {
                if (actor->flags & 4) {
                    actor->work_s[1] += actor->work_s[3];
                    actor->work_s[0] += actor->work_s[3];
                    actor->flags &= ~4;
                } else if (((actor->work_s[3] < 0 && RANDOM_F(1.f) > 0.85f) || (actor->work_s[3] > 0 && RANDOM_F(1.f) > 0.15f)) &&
                               (actor->work_s[1] < 5) ||
                           actor->work_s[1] == 0) {
                    xyz_t p2;
                    if (actor->work_s[3] < 0) {
                        actor->flags |= 2;
                        actor->flags |= 4;
                    }
                    actor->work_s[3] = 1;
                    actor->work_s[4] = DEG2SHORT_ANGLE(2.5f);
                    actor->work_s[1] += actor->work_s[3];
                    actor->work_s[0] += actor->work_s[3];
                    xyz_t_sub(&rail_pos[actor->work_s[1]], &actor->position, &p2);
                    actor->work_s[2] = atans_table(p2.z, p2.x);
                } else {
                    xyz_t p;
                    if (actor->work_s[3] > 0) {
                        actor->flags |= 2;
                        actor->flags |= 4;
                    }
                    actor->work_s[3] = -1;
                    actor->work_s[4] = DEG2SHORT_ANGLE(-2.5f);
                    actor->work_s[1] += actor->work_s[3];
                    actor->work_s[0] += actor->work_s[3];
                    xyz_t_sub(&rail_pos[actor->work_s[1]], &actor->position, &p);
                    actor->work_s[2] = atans_table(p.z, p.x);
                }
            }
        }
    }
}

void mi_dango_defence_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->work_s[7] < 0) {
        actor->work_s[7] = 10;
        actor->work_s[8] = 1;
    }
    actor->process_timer = (s16)RANDOM_F(260.f) + 500;
}

void mi_dango_defence(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->process_timer > 0 && actor->work_s[7] < 0) {
        actor->work_s[6] = 1;
        actor->work_s[8] = 0;
    }
    if (actor->process_timer < 0 && actor->work_s[6] == 1 && actor->work_s[7] < 0) {
        if (actor->work_s[8] == 0) {
            actor->work_s[8] = 1;
            actor->work_s[7] = 10;
        } else {
            actor->work_s[8] = 0;
            actor->work_s[6] = 0;
            actor->work_s[5] = 0;
            mi_dango_setupAction(actor, 0, game);
        }
    }
}

void mi_dango_setupAction(MUSEUM_INSECT_PRIVATE_DATA* actor, int r4, GAME* game) {
    static PRIV_INSECT_PROCESS init_proc[] = { mi_dango_move_init, mi_dango_defence_init };
    static PRIV_INSECT_PROCESS move_proc[] = { mi_dango_move, mi_dango_defence };
    actor->process = move_proc[r4];
    init_proc[r4](actor, game);
}

void minsect_dango_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p;
    actor->work_s[0] = RANDOM_F(5.f);
    if (RANDOM2_F(1.f) > 0.f && actor->work_s[0] < 5 || actor->work_s[0] == 0) {
        actor->work_s[3] = 1;
        actor->work_s[4] = DEG2SHORT_ANGLE(2.5f);
    } else {
        actor->work_s[3] = -1;
        actor->work_s[4] = DEG2SHORT_ANGLE(-2.5f);
    }
    actor->work_s[1] = actor->work_s[0] + actor->work_s[3];
    actor->position = rail_pos[actor->work_s[0]];
    xyz_t_sub(&rail_pos[actor->work_s[1]], &actor->position, &p);
    actor->rotation.y = actor->work_s[2] = atans_table(p.z, p.x);
    actor->speed = RANDOM_F(0.1f) + 0.065f;
    actor->process_timer = RANDOM_F(280.f) + 20.f;
    actor->_44 = ZeroVec;
    actor->velocity = ZeroVec;
    actor->params.work_f[0] = 1.0f;
    actor->work_s[6] = 0;
    mi_dango_setupAction(actor, 0, game);
    actor->work_s[7] = -1;
}

void minsect_dango_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    mi_dango_defence_anime(actor, game);
    mi_dango_check_player(actor, game);
    actor->work_s[5]--;
    if (actor->work_s[5] < 0) {
        actor->work_s[5] = 0;
    }
    if (actor->work_s[5] > 900) {
        actor->work_s[5] = 900;
    }
    if (actor->work_s[5] > 200) {
        if (actor->work_s[6] == 0 && actor->work_s[8] == 0) {
            mi_dango_setupAction(actor, 1, game);
        } else if (actor->process_timer < 10) {
            actor->process_timer++;
        }
    }
    if (GETREG(NMREG, 1)) {
        mi_dango_setupAction(actor, 1, game);
    }
    actor->process(actor, game);
}

void minsect_dango_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    if (actor->work_s[6]) {
        Matrix_rotateXYZ(DEG2SHORT_ANGLE2(GETREG(NMREG, 5) + 20.f), DEG2SHORT_ANGLE2(GETREG(NMREG, 6)),
                         DEG2SHORT_ANGLE2(GETREG(NMREG, 7)), MTX_MULT);
    }
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    if (actor->work_s[6]) {
        Matrix_scale(GETREG(NMREG, 2) * 0.01f + 1.2f, GETREG(NMREG, 3) * 0.01f + 1.2f, GETREG(NMREG, 4) * 0.01f + 1.2f,
                     MTX_MULT);
    }
    Matrix_scale(1.f, 1.f, actor->params.work_f[0], MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    if (actor->work_s[6]) {
        gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][1]);

    } else {
        gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    }
    minsect_draw_shadow(actor, game);
    CLOSE_DISP(game->graph);
}
