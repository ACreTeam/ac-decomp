#include "ac_museum_insect_priv.h"
xyz_t hachi_base_pos = { 165.5f, 78.5f, 482.5f };

void mi_hachi_hane_anime(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    static f32 scaleX_table[7] = { 1.f, 0.85f, 1.15f, 0.85f, 1.15f, 0.85f, 1.15f };
    if (actor->work_s[4] < 7) {
        if (chase_f(&actor->params.work_f[1], (GETREG(NMREG, 1) * 0.01f + 1.0f) * scaleX_table[actor->work_s[4]], 0.115f) == 1) {
            actor->work_s[4]--;
            if (actor->work_s[4] < 0) {
                actor->work_s[4] = (s16)(RANDOM_F(3.0f) * 60.f) + 187;
            }
        }
    } else {
        actor->work_s[4]--;
    }
}

void mi_hachi_mitu_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = 0;
    actor->work_s[5] = 0;
}

void mi_hachi_mitu(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->process_timer < 0) {
        if (actor->work_s[5] > (s16)(((s16)RANDOM_F(10.f) << 1) + 0x10)) {
            mi_hachi_setupAction(actor, 0, game);
            return;
        }
        actor->work_s[1] = -1820;
        actor->params.work_f[0] = GETREG(NMREG, 8) * 0.01f;
        actor->process_timer = 10;
        actor->work_s[5]++;
    }
    if (actor->work_s[0] == actor->work_s[1]) {
        actor->work_s[1] = 0;
        actor->params.work_f[0] = 0.0f;
    }
    if (GETREG(NMREG, 4)) {
        actor->work_s[2] = DEG2SHORT_ANGLE(GETREG(NMREG, 4) * 0.01f);
    }
    if (GETREG(NMREG, 5)) {
        actor->work_s[3] = DEG2SHORT_ANGLE(GETREG(NMREG, 5) * 0.01f);
    }
    if (GETREG(NMREG, 6)) {
        actor->_44.y = GETREG(NMREG, 6) * 0.01f;
    }
}

void mi_hachi_wait_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = (s16)RANDOM_F(120.f) + 40;
    if (actor->is_active == 0) {
        actor->process_timer *= 10;
    }
}

void mi_hachi_wait(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->process_timer < 0) {
        if (RANDOM_F(1.0f) > 0.9f || GETREG(NMREG, 0)) {
            if (RANDOM_F(1.0f) > 0.5f) {
                mi_hachi_setupAction(actor, 1, game);
            } else {
                mi_hachi_setupAction(actor, 2, game);
            }
            return;
        }
        actor->work_s[1] = -1820;
        actor->work_s[2] += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(30.f));
        actor->params.work_f[0] = GETREG(NMREG, 8) * 0.01f;
        actor->process_timer = (s16)RANDOM_F(120.f) + 40;
        if (actor->is_active == 0) {
            actor->process_timer *= 10;
        }
    }
    if (actor->work_s[0] == actor->work_s[1]) {
        actor->work_s[1] = 0;
        actor->params.work_f[0] = 0.0f;
    }
    if (GETREG(NMREG, 4)) {
        actor->work_s[2] = DEG2SHORT_ANGLE(GETREG(NMREG, 4) * 0.01f);
    }
    if (GETREG(NMREG, 5)) {
        actor->work_s[3] = DEG2SHORT_ANGLE(GETREG(NMREG, 5) * 0.01f);
    }
    if (GETREG(NMREG, 6)) {
        actor->_44.y = GETREG(NMREG, 6) * 0.01f;
    }
}

void mi_hachi_move_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer = (s16)RANDOM_F(720.f) + 360;
}

void mi_hachi_move(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->process_timer--;
    if (actor->process_timer < 0) {
        if (RANDOM_F(1.0f) > 0.2f || GETREG(NMREG, 1)) {
            if (RANDOM_F(1.0f) > 0.5f) {
                mi_hachi_setupAction(actor, 0, game);
                return;
            } else {
                mi_hachi_setupAction(actor, 2, game);
                return;
            }
        }
        actor->process_timer = (s16)RANDOM_F(720.f) + 360;
    }

    if (!actor->work_s[0]) {
        f32 v;
        actor->work_s[1] = -1820;
        if (RANDOM_F(1.0f) > 0.5f) {
            actor->work_s[2] += (s16)DEG2SHORT_ANGLE2(RANDOM_F(30.f) + 10.f);
        } else {
            actor->work_s[2] -= (s16)DEG2SHORT_ANGLE2(RANDOM_F(30.f) + 10.f);
        }
        actor->params.work_f[0] = GETREG(NMREG, 8) * 0.01f + 1.0f;
        v = -0.5f * sin_s(actor->work_s[2]);
        actor->work_s[3] += RAD2SHORT_ANGLE(v / 15.f);
        actor->_44.y += cos_s(actor->work_s[2]) * 0.5f;
        if (actor->_44.y > 10.f) {
            actor->work_s[2] = DEG2SHORT_ANGLE(RANDOM2_F(60.f)) + DEG2SHORT_ANGLE(180);
            actor->_44.y = 10.f;
        } else if (actor->_44.y < -10.f) {
            actor->work_s[2] = DEG2SHORT_ANGLE(RANDOM2_F(60.f));
            actor->_44.y = -10.f;
        }
        if (actor->work_s[3] > DEG2SHORT_ANGLE(30)) {
            actor->work_s[2] = DEG2SHORT_ANGLE(RANDOM2_F(60.f)) + DEG2SHORT_ANGLE(90);
            actor->work_s[3] = DEG2SHORT_ANGLE(30);
        } else if (actor->work_s[3] < DEG2SHORT_ANGLE(-30)) {
            actor->work_s[2] = DEG2SHORT_ANGLE(RANDOM2_F(60.f)) - DEG2SHORT_ANGLE(90);
            actor->work_s[3] = DEG2SHORT_ANGLE(-30);
        }
    } else if (actor->work_s[0] == actor->work_s[1]) {
        actor->work_s[1] = 0;
        actor->params.work_f[0] = 0.0f;
    }
}

void mi_hachi_setupAction(MUSEUM_INSECT_PRIVATE_DATA* actor, int r4, GAME* game) {
    static PRIV_INSECT_PROCESS init_proc[3] = { mi_hachi_wait_init, mi_hachi_move_init, mi_hachi_mitu_init };
    static PRIV_INSECT_PROCESS move_proc[3] = { mi_hachi_wait, mi_hachi_move, mi_hachi_mitu };
    actor->process = move_proc[r4];
    init_proc[r4](actor, game);
}

void minsect_hachi_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->position = ZeroVec;
    actor->rotation = ZeroSVec;
    actor->_44 = actor->position;
    actor->work_s[3] = 0;
    actor->params.work_f[1] = 1.0f;
    actor->work_s[4] = (s16)(RANDOM_F(5.0f) * 60.f) + 307;
    mi_hachi_setupAction(actor, 0, game);
}

void minsect_hachi_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->is_active = get_now_mind_flag(actor, game);
    mi_hachi_hane_anime(actor);
    actor->process(actor, game);
    add_calc_short_angle2(&actor->work_s[0], actor->work_s[1], CALC_EASE2(GETREG(NMREG, 0x5e) * 0.01f + 0.8f),
                          (s16)(DEG2SHORT_ANGLE(GETREG(NMREG, 0x5F) * 0.01f + 4.0f) >> 1) >> 1, DEG2SHORT_ANGLE(0.25f));
    add_calc_short_angle2(&actor->rotation.z, actor->work_s[2], CALC_EASE2(0.4f),
                          (s16)(DEG2SHORT_ANGLE(GETREG(NMREG, 3) * 0.01f + 5.0f) >> 1) >> 1, DEG2SHORT_ANGLE(0.25f));
    add_calc_short_angle2(&actor->rotation.y, actor->work_s[3], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f), DEG2SHORT_ANGLE(0.25f));
    add_calc(&actor->speed, actor->params.work_f[0], CALC_EASE(0.1f), 0.25f, 0.05f);
    chase_xyz_t(&actor->position, &actor->_44, actor->speed);
}

void minsect_hachi_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(hachi_base_pos.x, hachi_base_pos.y, hachi_base_pos.z, MTX_LOAD);
    Matrix_rotateXYZ(DEG2SHORT_ANGLE(-20), 0, 0, MTX_MULT);
    Matrix_translate(0.0f, actor->position.y, 0.0f, MTX_MULT);
    Matrix_translate(-GETREG(NMREG, 0x10) * 0.01f, -GETREG(NMREG, 0x11) * 0.01f, -15.f - GETREG(NMREG, 0xe) * 0.01f,
                     MTX_MULT);
    Matrix_rotateXYZ(0, actor->rotation.y, 0, MTX_MULT);
    Matrix_translate(GETREG(NMREG, 0x10) * 0.01f, GETREG(NMREG, 0x11) * 0.01f, 15.f + GETREG(NMREG, 0xe) * 0.01f, MTX_MULT);
    Matrix_rotateXYZ(0, 0, actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(actor->work_s[0], 0, 0, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    Matrix_rotateXYZ(DEG2SHORT_ANGLE(90), 0, DEG2SHORT_ANGLE(-180), MTX_MULT);

    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);

    _texture_z_light_fog_prim_xlu(game->graph);
    OPEN_POLY_XLU_DISP(game->graph);
    gDPSetEnvColor(POLY_XLU_DISP++, 0xff, 0xff, 0xff, 0xff);
    Matrix_scale(actor->params.work_f[1], 1.0f, 1.0f, MTX_MULT);
    gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][1]);
    CLOSE_POLY_XLU_DISP(game->graph);
}
