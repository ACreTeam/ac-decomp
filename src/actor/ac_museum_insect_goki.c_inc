#include "ac_museum_insect_priv.h"

// UNUSED
void mi_goki_hane_anime() {
}

void minsect_goki_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    actor->position.x = 280.f;
    actor->position.y = 40.f;
    actor->position.z = 320.f;
    actor->velocity = ZeroVec;
    actor->speed = 0.f;
    actor->_44 = ZeroVec;
    actor->rotation = ZeroSVec;
    actor->rotation.y = (int)RANDOM_F(16.f) * (0x10000 / 16);
    actor->process_timer = (s16)RANDOM_F(420.f) + 180;
    actor->_44.y = -0.225;
    actor->params.work_f[0] = 1.f;
    actor->work_s[2] = 0;
    actor->work_s[1] = 0;
    actor->work_s[4] = 0;
}

BOOL goki_player_check(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    BOOL ret;
    if (player->actor_class.speed > 0 &&
        search_position_distanceXZ(&player->actor_class.world.position, &actor->position) < 40.f) {
        actor->rotation.y = search_position_angleY(&player->actor_class.world.position, &actor->position);
        actor->rotation.y += (s16)DEG2SHORT_ANGLE2(RANDOM2_F(180.f));
        //! NOTE: huh?
        actor->rotation.y &= 0xf000;
        return TRUE;
    } else {
        return FALSE;
    }
}

void goki_wall_hit_angle_corect_sub(MUSEUM_INSECT_PRIVATE_DATA* actor, int _angle) {
    f32 r = RANDOM_F(1.f);
    s16 angle = _angle;
    if (actor->rotation.y == (s16)(angle + DEG2SHORT_ANGLE2(180))) {
        if (r < 0.5f) {
            if (r < 0.25f) {
                actor->rotation.y = angle - DEG2SHORT_ANGLE(90);
            } else {
                actor->rotation.y = angle + DEG2SHORT_ANGLE(90);
            }
        } else {
            actor->rotation.y = _angle;
            actor->rotation.y += (s16)((int)RANDOM2_F(8.f) * 4096);
        }
    } else if (actor->rotation.y - angle > 0) {
        if (r < 0.5f) {
            actor->rotation.y = angle + DEG2SHORT_ANGLE(90);
        } else {
            actor->rotation.y = angle - DEG2SHORT_ANGLE(90);
            actor->rotation.y += (s16)((int)RANDOM_F(8.f) * 4096);
        }
    } else {
        if (r < 0.5f) {
            actor->rotation.y = angle - DEG2SHORT_ANGLE(90);
        } else {
            actor->rotation.y = angle + DEG2SHORT_ANGLE(90);
            actor->rotation.y += (s16)((int)-RANDOM_F(8.f) * 4096);
        }
    }
}

void goki_wall_hit_angle_corect(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->flags & 2) {
        goki_wall_hit_angle_corect_sub(actor, DEG2SHORT_ANGLE(90));
    } else if (actor->flags & 4) {
        goki_wall_hit_angle_corect_sub(actor, DEG2SHORT_ANGLE(-90));
    } else if (actor->flags & 8) {
        goki_wall_hit_angle_corect_sub(actor, DEG2SHORT_ANGLE(0));
    } else if (actor->flags & 0x10) {
        goki_wall_hit_angle_corect_sub(actor, (s16)DEG2SHORT_ANGLE2(180));
    }
}

void goki_set_talk_info_init(ACTOR* actor) {
    int info = mMmd_InsectInfo(0x1c);
    int i;
    if (info < 1 || info > 4) {
        i = MSG_12197;
    } else {
        if (info >= 1 && info <= 4) {
            mMsg_Set_free_str(mMsg_Get_base_window_p(), mMsg_FREE_STR0,
                              common_data.save.save.private_data[info - 1].player_ID.player_name, 8);
        }
        i = MSG_12196;
    }
    mDemo_Set_talk_window_color(&window_color);
    mDemo_Set_talk_display_name(0);
    mDemo_Set_msg_num(i);
    mDemo_Set_use_zoom_sound(TRUE);
    mDemo_Set_talk_turn(0);
}

void goki_talk_process(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (mDemo_Check(8, &MI_Control_Actor->actor) == TRUE) {
        if (mDemo_Check_ListenAble() == FALSE) {
            mDemo_Set_ListenAble();
            mDemo_Set_camera(CAMERA2_PROCESS_NORMAL);
            mPlib_Set_able_hand_all_item_in_demo(FALSE);
        }
    } else {
        actor->process = NULL;
    }
}

void goki_talk_process_init(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    mDemo_Request(8, &MI_Control_Actor->actor, goki_set_talk_info_init);
    actor->process = goki_talk_process;
}

void minsect_goki_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    xyz_t* target = &player->actor_class.world.position;
    if (actor->process) {
        actor->process(actor, game);
    }

    if (actor->work_s[1] == 0) {
        if (search_position_distanceXZ(&actor->position, target) < 20.f && player->actor_class.speed > 7.f &&
            RANDOM_F(1.f) > 0.4f) {
            actor->work_s[1] = 1;
            actor->speed = RANDOM_F(1.f) + 2.f + GETREG(NMREG, 3) * 0.01f;
            actor->velocity.y = GETREG(NMREG, 2) * 0.01f + 3.25f;
            actor->work_s[2] = 1;
            sAdo_OngenTrgStart(0x132, &actor->position);
            return;
        }

        if (search_position_distanceXZ(&actor->position, target) < 15.f && player->actor_class.speed > 1.f) {
            if (RANDOM_F(1.f) > 0.9f) {
                actor->work_s[1] = 1;
                actor->speed = RANDOM_F(1.f) + 2.f + GETREG(NMREG, 3) * 0.01f;
                actor->velocity.y = GETREG(NMREG, 2) * 0.01f + 3.25f;
                actor->work_s[2] = 1;
                sAdo_OngenTrgStart(0x132, &actor->position);
                return;
            }

            if (player->actor_class.speed > 0.f && actor->work_s[4] != 1) {
                goki_talk_process_init(actor, game);
                actor->work_s[4] = 1;
            }
        }

        if (actor->speed > 0.f) {
            goki_wall_hit_angle_corect(actor, game);
            mID_insect_moveF(actor);
            sAdo_OngenPos((u32)actor, 0xa8, &actor->position);
            if (actor->process_timer-- < 0) {
                if (RANDOM_F(1.f) > 0.2f) {
                    actor->process_timer = (s16)RANDOM_F(420.f) + 180;
                    actor->speed = 0.f;
                } else if (goki_player_check(actor, game)) {
                    actor->process_timer = (s16)RANDOM_F(120.f) + 40;
                } else {
                    actor->process_timer = (s16)RANDOM_F(120.f) + 40;
                    actor->rotation.y = qrand() & 0xf000;
                }
            }
        } else {
            if (actor->process_timer-- < 0) {
                actor->process_timer = (s16)RANDOM_F(120.f) + 40;
                actor->speed = 3.5f;
                actor->rotation.y = qrand() & 0xf000;
            } else if (goki_player_check(actor, game)) {
                actor->process_timer = (s16)RANDOM_F(120.f) + 40;
                actor->speed = 3.5f;
            }
        }
    } else {
        actor->rotation.x = -atans_table(actor->speed, actor->velocity.y);
        if (actor->velocity.y < 0.f && actor->flags & 0x20) {
            actor->rotation.x = 0;
            actor->work_s[1] = 0;
            actor->process_timer = (s16)RANDOM_F(120.f) + 40;
            actor->speed = 3.5f;
            actor->work_s[2] = 0;
            return;
        }

        mID_insect_moveF(actor);
        actor->velocity.y += actor->_44.y;
        mi_batta_hane_anime(actor);

        if (actor->work_s[3] <= 0) {
            actor->work_s[3] = 7;
        }
    }
    minsect_goki_BGCheck(actor);
}

void minsect_goki_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);
    if (actor->work_s[2]) {
        _texture_z_light_fog_prim_xlu(game->graph);
        OPEN_POLY_XLU_DISP(game->graph);
        Matrix_scale(actor->params.work_f[0], 1.0f, 1.0f, MTX_MULT);
        gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
        gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][1]);
        CLOSE_POLY_XLU_DISP(game->graph);
    }
    minsect_draw_shadow(actor, game);
}
