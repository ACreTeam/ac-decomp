#include "ac_museum_insect_priv.h"

void minsect_semi_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    const static xyz_t init_pos[4] = {
        { 97.f, 85.f, -18.5f }, { 396.f, 85.5f, -20.f }, { 471.5f, 65.5f, 4.5f }, { 248.f, 88.f, -21.f }
    };
    int s;
    actor->params.work_f[0] = 1.0f;
    actor->work_s[0] = 0;
    actor->work_s[3] = 0;
    actor->work_s[2] = 0;
    actor->work_s[4] = 0;
    s = (actor->insect_type - 4);
    actor->position = init_pos[s];
    actor->rotation = ZeroSVec;
    actor->rotation.x = DEG2SHORT_ANGLE(-70);
    actor->rotation.y = DEG2SHORT_ANGLE(-180);

    actor->_44 = actor->velocity = ZeroVec;
}

void mi_semi_hane_anime(MUSEUM_INSECT_PRIVATE_DATA* actor) {
    static float scaleX_table[7] = { 1.15f, 1.f, 1.15f, 1.f, 1.15f, 1.f, 1.15f };
    if (actor->work_s[0] < 7) {
        if (chase_f(&actor->params.work_f[0], (GETREG(NMREG, 1) * 0.01f + 1.0f) * scaleX_table[actor->work_s[0]], 0.23f) == TRUE) {
            actor->work_s[0]--;
            if (actor->work_s[0] < 0) {
                actor->work_s[0] = 0;
            }
        }
    } else {
        actor->work_s[0]--;
    }
}

void mi_semi_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (dist < 120.f) {
        if (player->actor_class.speed > 1.4f) {
            actor->work_s[3] += (s16)((dist / 120.f) * 8.0f);
        } else if (player->actor_class.speed > 5.0f) {
            actor->work_s[3] += (s16)((dist / 120.f) * 20.0f);
        }
    }
}

void minsect_semi_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    int id = actor->insect_type - 4;
    get_now_mind_flag(actor, game);
    if (actor->is_active) {
        mi_semi_hane_anime(actor);
        add_calc_short_angle2(&actor->work_s[1], actor->work_s[2], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f),
                              DEG2SHORT_ANGLE(0.25f));
        mi_semi_check_player(actor, game);
        actor->work_s[3]--;
        if (actor->work_s[3] < 0) {
            actor->work_s[3] = 0;
        }
        if (actor->work_s[3] > 900) {
            actor->work_s[3] = 900;
        }
        if (actor->work_s[3] > 500) {
            actor->work_s[2] = 0;
        } else {
            if (actor->work_s[4] != 0) {
                actor->work_s[2] = DEG2SHORT_ANGLE(-10);
            }
            actor->process_timer--;
            if (actor->process_timer < 0) {
                if (actor->work_s[4] != 0) {
                    actor->work_s[4] = 0;
                    actor->work_s[2] = 0;
                    actor->process_timer = (s16)RANDOM_F(360.f) + 360;
                } else {
                    actor->work_s[4] = 1;
                    actor->work_s[2] = DEG2SHORT_ANGLE(-10);
                    actor->process_timer = (s16)RANDOM_F(6000.f) + 12000;
                }
            }
            if (actor->work_s[4] == 1 && actor->work_s[1] == actor->work_s[2]) {
                static const u8 semi_sound_data[4] = { 0x9b, 0x9a, 0x98, 0x97 };
                PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
                if (search_position_distance(&actor->position, &player->actor_class.world.position) < 200.f) {
                    sAdo_OngenPos((u32)actor, semi_sound_data[id], &actor->position);
                }
                if (actor->work_s[0] <= 0) {
                    actor->work_s[0] = 7;
                }
            }
        }
    }
}

void minsect_semi_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    _texture_z_light_fog_prim(game->graph);

    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(actor->work_s[1], 0, 0, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    Matrix_rotateXYZ(actor->rotation.x, actor->rotation.y, actor->rotation.z, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(NEXT_POLY_OPA_DISP, 0, 0xff, 0x9b, 0xff);
    gSPDisplayList(NEXT_POLY_OPA_DISP, minsect_mdl[actor->insect_type][0]);
    CLOSE_DISP(game->graph);

    _texture_z_light_fog_prim_xlu(game->graph);

    OPEN_POLY_XLU_DISP(game->graph);
    gDPSetEnvColor(POLY_XLU_DISP++, 0xff, 0xff, 0xff, 0xff);
    Matrix_scale(actor->params.work_f[0] + (GETREG(NMREG, 1) * 0.01f), GETREG(NMREG, 2) * 0.01f + 1.0f,
                 GETREG(NMREG, 3) * 0.01f + 1.0f, MTX_MULT);
    gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(POLY_XLU_DISP++, minsect_mdl[actor->insect_type][1]);
    CLOSE_POLY_XLU_DISP(game->graph);
}
