#include "ac_museum_insect_priv.h"

const xyz_t base_genji_pos = { 258.f, 62.f, 258.5f };

const xyz_t genji_mizu_pos = { 289.f, 25.f, 218.f };

void mi_genji_check_player(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    PLAYER_ACTOR* player = get_player_actor_withoutCheck((GAME_PLAY*)game);
    f32 dist = search_position_distance(&actor->position, &player->actor_class.world.position);
    if (dist > 160.f && actor->point_light_id != -1 && actor->work_s[5] == 0) {
        actor->work_s[6] = 0;
        mEnv_CancelReservedPointLight(actor->point_light_id, (GAME_PLAY*)game);
        actor->point_light_id = -1;
    } else if (dist > 160.f && actor->point_light_id != -1 && actor->work_s[6] != 0) {
        actor->work_s[6] = 0;
    } else if (dist <= 160.f) {
        actor->work_s[6] = 150;
        if (actor->point_light_id == -1) {
            xyz_t p = actor->position;
            p.z += 10.f;
            actor->point_light_id = mEnv_ReservePointLight((GAME_PLAY*)game, &p, 0x78, 0xff, 0xb4, actor->work_s[5]);
        }
    }
}

void genji_light_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game, s16 r5) {
    actor->flags |= 1;
    actor->position = genji_mizu_pos;
    actor->params.genji.glow_height = actor->position.y;
    actor->_10 = RANDOM_F(50.f) + 100.f;
    actor->_0C = 1.f;
    actor->work_s[0] = (s16)RANDOM_F(180.f);
    actor->params.genji.fuwafuwa_phase = qrand();
    actor->rotation.y = qrand();
    if (r5) {
        actor->params.genji.target_angle = qrand();
    } else {
        actor->params.genji.target_angle = DEG2SHORT_ANGLE(20);
    }

    actor->velocity = ZeroVec;
    actor->_44 = ZeroVec;
    actor->speed = 0.75f;
    actor->process_timer = (s16)RANDOM_F(120.f) + 60;
    actor->work_s[4] = r5;
}

void genji_light_make(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game, s16 i) {
    actor->flags |= 1;
    actor->position = genji_mizu_pos;
    actor->position.x += RANDOM2_F(50.f);
    actor->position.z += RANDOM2_F(36.f);
    actor->position.y += 5.f;
    actor->params.genji.glow_height = actor->position.y;
    actor->_10 = RANDOM_F(50.f) + 100.f;
    actor->_0C = 0.f;
    actor->work_s[0] = RANDOM_F(180.f);
    actor->params.genji.fuwafuwa_phase = qrand();
    actor->rotation.y = qrand();
    actor->params.genji.target_angle = qrand();
    actor->velocity = ZeroVec;
    actor->_44 = ZeroVec;
    actor->speed = 0.75f;
    actor->process_timer = (s16)RANDOM_F(120.f) + 60;
    actor->work_s[4] = i;
}

void genji_light_anime(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    if (actor->work_s[0] < 30) {
        actor->work_s[1] = 0;
        actor->work_s[2] = 1;
        actor->work_s[3] = 255.f - 255 * (actor->work_s[0] / 30.f);
    } else if (actor->work_s[0] < 60) {
        actor->work_s[1] = 1;
        actor->work_s[2] = 2;
        actor->work_s[3] = 255.f - 255 * ((actor->work_s[0] - 30.f) / 30.f);
    } else if (actor->work_s[0] < 90) {
        actor->work_s[1] = 2;
        actor->work_s[2] = 3;
        actor->work_s[3] = 255.f - 255 * ((actor->work_s[0] - 60.f) / 30.f);
    } else if (actor->work_s[0] < 120) {
        actor->work_s[1] = 2;
        actor->work_s[2] = 3;
        actor->work_s[3] = 255 * ((actor->work_s[0] - 90.f) / 30.f);
    } else if (actor->work_s[0] < 150) {
        actor->work_s[1] = 1;
        actor->work_s[2] = 2;
        actor->work_s[3] = 255 * ((actor->work_s[0] - 120.f) / 30.f);
    } else if (actor->work_s[0] < 180) {
        actor->work_s[1] = 0;
        actor->work_s[2] = 1;
        actor->work_s[3] = 255 * ((actor->work_s[0] - 150.f) / 30.f);
    } else {
        actor->work_s[0] = 0;
    }
    actor->work_s[0]++;
    if (actor->work_s[6]) {
        actor->work_s[5] += 3;
        if (actor->work_s[5] > actor->work_s[6]) {
            actor->work_s[5] = actor->work_s[6];
        }
    } else {
        actor->work_s[5] -= 3;
        if (actor->work_s[5] < 0) {
            actor->work_s[5] = 0;
        }
    }
    mEnv_OperateReservedPointLight_Power(actor->point_light_id, actor->work_s[5]);
}

void genji_light_move(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    s16 ang;
    f32 v;
    mEnv_OperateReservedPointLight_Position(actor->point_light_id, &actor->position);
    actor->process_timer--;
    if (actor->flags & 0x100) {
        actor->_0C -= 0.0125f;
        if (actor->_0C < 0.0125f) {
            actor->flags = 0;
            return;
        }
    } else {
        actor->_0C += 0.0125f;
        if (actor->_0C > 1.f) {
            actor->_0C = 1.f;
        }
    }
    mID_insect_moveF(actor);
    ang = add_calc_short_angle2(&actor->rotation.y, actor->params.genji.target_angle, CALC_EASE2(0.1f), DEG2SHORT_ANGLE(0.5f),
                                DEG2SHORT_ANGLE(0.25f));
    if (actor->process_timer < 0) {
        actor->params.genji.target_angle = qrand();
        actor->process_timer = (s16)RANDOM_F(120.f) + 60;
    } else if (actor->flags & 8) {
        actor->params.genji.target_angle = DEG2SHORT_ANGLE2(RANDOM2_F(60.f));
        actor->process_timer = (s16)RANDOM_F(120.f) + 60;
    } else if (actor->flags & 0x10) {
        actor->process_timer = (s16)RANDOM_F(120.f) + 60;
        actor->params.genji.target_angle = DEG2SHORT_ANGLE2(-180.f + RANDOM2_F(60.f));
    } else if (actor->flags & 2) {
        actor->process_timer = (s16)RANDOM_F(120.f) + 60;
        actor->params.genji.target_angle = DEG2SHORT_ANGLE2(90.f + RANDOM2_F(90.f));
    } else if (actor->flags & 4) {
        actor->process_timer = (s16)RANDOM_F(120.f) + 60;
        actor->params.genji.target_angle = DEG2SHORT_ANGLE2(-90.f + RANDOM2_F(90.f));
    }
    actor->params.genji.fuwafuwa_phase += (s16)DEG2SHORT_ANGLE2(RANDOM_F(5.f) + 1.5f);
    add_calc(&actor->params.genji.glow_height, actor->_10, CALC_EASE(0.3f), 0.75f, 0.25f);
    actor->position.y = actor->params.genji.glow_height + 10.f * sin_s(actor->params.genji.fuwafuwa_phase);
    minsect_tree_ObjCheck(actor);
    minsect_fly_BGCheck(actor, 360.0, 40.0);
    genji_light_anime(actor, game);
}

void genji_light_draw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p = actor->position;
    u8 a, b;
    if (F32_IS_ZERO(actor->_0C)) {
        return;
    }

    if (actor->work_s[4] == 0) {
        p.x += -3.f * sin_s(-actor->rotation.z);
        p.y += -3.f * cos_s(-actor->rotation.z);
        p.z += 6.f + cos_s(actor->work_s[7]);
    }
    a = actor->work_s[3];
    b = (255 - actor->work_s[3]);
    a -= (u8)(a * (1.f - actor->_0C));
    b -= (u8)(b * (1.f - actor->_0C));
    _texture_z_light_fog_prim_xlu(game->graph);
    OPEN_POLY_XLU_DISP(game->graph);
    Matrix_translate(p.x, p.y, p.z, MTX_LOAD);
    Matrix_mult(&((GAME_PLAY*)game)->billboard_matrix, MTX_MULT);
    Matrix_scale(actor->scale, actor->scale, actor->scale, MTX_MULT);
    gSPMatrix(POLY_XLU_DISP++, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gDPSetEnvColor(POLY_XLU_DISP++, 0, 0xff, 0x9b, a);
    gSPDisplayList(POLY_XLU_DISP++, m_genji_disp_tbl[actor->work_s[1]]);
    gDPSetEnvColor(POLY_XLU_DISP++, 0, 0xff, 0x9b, b);
    gSPDisplayList(POLY_XLU_DISP++, m_genji_disp_tbl[actor->work_s[2]]);
    CLOSE_POLY_XLU_DISP(game->graph);
    minsect_draw_shadow(actor, game);
}

void minsect_genji_ct(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    genji_light_ct(actor, game, 0);
    actor->position = base_genji_pos;
    actor->rotation.z = DEG2SHORT_ANGLE(-25);
    actor->work_s[9] = (s16)RANDOM_F(60.f) + 600;
}

void minsect_genji_mv(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    MUSEUM_INSECT_PRIVATE_DATA* priv;
    BOOL found;
    s16 i;
    found = FALSE;
    priv = &MI_Control_Actor->firefly_particles[0];
    mi_genji_check_player(actor, game);
    mEnv_OperateReservedPointLight_Position(actor->point_light_id, &actor->position);
    actor->is_active = get_now_mind_flag(actor, game);
    genji_light_anime(actor, game);
    if (actor->is_active == 0) {
        actor->_0C -= 0.04f;
        if (actor->_0C < 0.04f) {
            actor->_0C = 0.f;
            if (actor->point_light_id != -1) {
                mEnv_CancelReservedPointLight(actor->point_light_id, (GAME_PLAY*)game);
                actor->point_light_id = -1;
            }
        }
    } else {
        actor->_0C += 0.04f;
        if (actor->_0C > 1.0f) {
            actor->_0C = 1.0f;
        }
    }
    actor->work_s[9]--;
    if (actor->work_s[9] < 0) {
        actor->work_s[8] = DEG2SHORT_ANGLE(-7);
        actor->work_s[9] = (int)RANDOM_F(60.f) + 600;
        if (RANDOM_F(1.f) > 0.5f) {
            actor->params.genji.target_angle = DEG2SHORT_ANGLE(RANDOM2_F(40.f));
        } else {
            actor->params.genji.target_angle = DEG2SHORT_ANGLE(20);
        }
    }
    if (actor->work_s[7] == actor->work_s[8]) {
        actor->work_s[8] = 0;
    }
    add_calc_short_angle2(&actor->rotation.z, actor->params.genji.target_angle, CALC_EASE2(0.4f),
                          (s16)(DEG2SHORT_ANGLE(GETREG(NMREG, 3) * 0.01f + 5.f) >> 1) >> 1, DEG2SHORT_ANGLE(0.25f));
    add_calc_short_angle2(&actor->work_s[7], actor->work_s[8], CALC_EASE2(0.4f), DEG2SHORT_ANGLE(0.75f), DEG2SHORT_ANGLE(0.25f));
    for (i = 0 + 1; i < 6 + 1; i++, priv++) {
        if (priv->flags & 1) {
            if ((GETREG(NMREG, 0xF) || (RANDOM_F(1.f) > 0.9f && actor->process_timer < 0)) && (priv->flags & 0x100) == 0) {

                if (priv->point_light_id != -1) {
                    mEnv_CancelReservedPointLight(priv->point_light_id, (GAME_PLAY*)game);
                    priv->point_light_id = -1;
                }
                priv->flags |= 0x100;
                actor->process_timer = RANDOM_F(1500.f);
                found = TRUE;
            } else if (actor->is_active == 0) {
                if (actor->process_timer < 0 && (priv->flags & 0x100) == 0) {
                    if (priv->point_light_id != -1) {
                        mEnv_CancelReservedPointLight(priv->point_light_id, (GAME_PLAY*)game);
                        priv->point_light_id = -1;
                    }
                    priv->flags |= 0x100;
                    actor->process_timer = RANDOM_F(1500.f);
                }
                found = TRUE;
            }
            mi_genji_check_player(priv, game);
            genji_light_move(priv, game);
            priv->scale = actor->scale;
        } else if (actor->is_active == 1) {
            if (actor->process_timer < 0) {
                genji_light_make(priv, game, i);
                actor->process_timer = RANDOM_F(300.f);
            }
            found = TRUE;
        }
    }

    if (found == TRUE) {
        actor->process_timer--;
    }
}

extern Gfx act_m_mu_genji_modelT;

void minsect_genji_dw(MUSEUM_INSECT_PRIVATE_DATA* actor, GAME* game) {
    MUSEUM_INSECT_PRIVATE_DATA* priv = &MI_Control_Actor->firefly_particles[0];
    int i;
    for (i = 0; i < 6; i++, priv++) {
        if (priv->flags & 1) {
            genji_light_draw(priv, game);
        }
    }
    _texture_z_light_fog_prim(game->graph);
    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x + GETREG(NMREG, 0x10) * 0.01f, actor->position.y + GETREG(NMREG, 0x11) * 0.01f,
                     actor->position.z + GETREG(NMREG, 0x12) * 0.01f, MTX_LOAD);
    Matrix_rotateXYZ(0, 0, actor->rotation.z, MTX_MULT);
    Matrix_rotateXYZ(actor->work_s[7], 0, 0, MTX_MULT);
    Matrix_rotateXYZ(DEG2SHORT_ANGLE(110), 0, DEG2SHORT_ANGLE2(180), MTX_MULT);
    Matrix_scale(0.01f, 0.01f, 0.01f, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(NEXT_POLY_OPA_DISP, &act_m_mu_genji_modelT);
    CLOSE_DISP(game->graph);
    genji_light_draw(actor, game);
}
